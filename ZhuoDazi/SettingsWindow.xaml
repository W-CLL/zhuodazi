<Window x:Class="ZhuoDazi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZhuoDazi.Controls"
        Title="桌搭子设置" Width="1000" Height="720" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F8FAF9" ShowInTaskbar="True"
        Icon="pack://application:,,,/assets/app-icon.png" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="NavBrush" Color="#F0F4F2" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#DDEFE9" />
        <SolidColorBrush x:Key="HoverBrush" Color="#E7EEEB" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84640" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="#FFF9F8" />
            <Setter Property="BorderBrush" Value="#E8C9C6" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="#AEBAB6" BorderThickness="1">
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 15,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" CornerRadius="5" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#EFF4F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="#0E695A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Width" Value="188" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#46504D" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavItem" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Border x:Name="SelectionBar" Width="3" Height="24" CornerRadius="2"
                                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                        Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#0F6C5D" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionDivider" TargetType="Separator">
            <Setter Property="Margin" Value="0,22" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabs" SelectedIndex="0" TabStripPlacement="Left" Background="#F8FAF9" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                            <TabPanel IsItemsHost="True" Margin="0,14,0,0" />
                        </Border>
                        <Border Grid.Column="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem x:Name="AppearanceTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" Width="30"/><TextBlock Text="外观与行为"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="38,30,38,34" MaxWidth="720" HorizontalAlignment="Stretch">
                        <TextBlock Text="外观与行为" Style="{StaticResource PageTitle}" Margin="0,0,0,28" />

                        <TextBlock Text="桌宠大小" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SizeSlider" Height="30" Minimum="140" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged" />
                            <TextBlock x:Name="SizeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </Grid>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="透明度" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Height="30" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OpacityValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </Grid>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="行为性格" Style="{StaticResource SectionTitle}" />
                        <ComboBox x:Name="PersonalityCombo" Width="220" HorizontalAlignment="Left"
                                  SelectionChanged="PersonalityCombo_SelectionChanged">
                            <ComboBoxItem Content="活泼" Tag="lively" />
                            <ComboBoxItem Content="害羞" Tag="shy" />
                            <ComboBoxItem Content="黏人" Tag="clingy" />
                            <ComboBoxItem Content="混乱" Tag="chaotic" />
                        </ComboBox>
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="MouseInteractionCheck" Content="跟随与躲避鼠标" Margin="0,6,26,6"
                                      Checked="MouseInteractionCheck_Changed" Unchecked="MouseInteractionCheck_Changed" />
                            <CheckBox x:Name="RandomMovementCheck" Content="自动随机走动"
                                      Checked="RandomMovementCheck_Changed" Unchecked="RandomMovementCheck_Changed" />
                        </WrapPanel>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="随机小剧场" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="TheaterEnabledCheck" Content="自动随机上演"
                                  Checked="TheaterEnabledCheck_Changed" Unchecked="TheaterEnabledCheck_Changed" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="TheaterIntervalCombo" SelectionChanged="TheaterIntervalCombo_SelectionChanged">
                                <ComboBoxItem Content="每 1 分钟" Tag="60" />
                                <ComboBoxItem Content="每 3 分钟" Tag="180" />
                                <ComboBoxItem Content="每 5 分钟" Tag="300" />
                                <ComboBoxItem Content="每 10 分钟" Tag="600" />
                                <ComboBoxItem Content="每 30 分钟" Tag="1800" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="立即上演" Margin="10,0,0,0" Click="StartTheater_Click" />
                        </Grid>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="TopmostCheck" Content="始终置顶" Click="TopmostCheck_Click" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Click="StartWithWindowsCheck_Click" />
                        <CheckBox x:Name="MirrorCheck" Content="水平镜像桌宠" Click="MirrorCheck_Click" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="鼠标穿透" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Button x:Name="ClickThroughButton" Grid.Column="1" Margin="24,0,0,0" ToolTip="快捷键：Ctrl + Shift + P" Click="ClickThroughButton_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE91B;" Width="30"/><TextBlock Text="我的桌宠"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="38,30,38,34" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="我的桌宠" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="PetCountText" Margin="0,0,0,22" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ListBox x:Name="PetList" Grid.Row="1" MinHeight="300"
                             ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Width" Value="220" />
                                <Setter Property="Height" Value="250" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="178" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#F3F7F5" CornerRadius="5" Padding="8">
                                        <controls:AnimatedGifImage FilePath="{Binding Path}" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="3,10,3,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="GIF 桌宠" Margin="0,3,0,0" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="添加 GIF" Style="{StaticResource PrimaryButton}" Click="AddPet_Click" Margin="0,0,8,0" />
                        <Button Content="使用所选" Click="UseSelectedPet_Click" Margin="0,0,8,0" />
                        <Button Content="使用默认" Click="UseDefaultPet_Click" Margin="0,0,8,0" />
                        <Button Content="删除所选" Style="{StaticResource DangerButton}" Click="DeletePet_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Width="30"/><TextBlock Text="资源库"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="38,30,38,34" MaxWidth="720" HorizontalAlignment="Stretch">
                        <TextBlock Text="GIF 资源库" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="LibrarySummary" Margin="0,0,0,26" Style="{StaticResource Hint}" />
                        <TextBlock Text="可用资源库" Style="{StaticResource FieldLabel}" />
                        <ListBox x:Name="LibraryList" Height="220" Margin="0,0,0,14"
                                 SelectionChanged="LibraryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                   Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="当前目录" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LibraryPathText" IsReadOnly="True" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="绑定目录" Style="{StaticResource PrimaryButton}" Click="ChooseLibrary_Click" Margin="0,0,8,0" />
                            <Button x:Name="DeleteLibraryButton" Content="删除所选" Style="{StaticResource DangerButton}"
                                    Click="DeleteLibrary_Click" />
                        </WrapPanel>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="随机切换" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="RandomPetCheck" Content="自动随机切换桌宠" Click="RandomPetCheck_Click" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RandomIntervalCombo" SelectionChanged="RandomIntervalCombo_SelectionChanged">
                                <ComboBoxItem Content="每 30 秒" Tag="30" />
                                <ComboBoxItem Content="每 1 分钟" Tag="60" />
                                <ComboBoxItem Content="每 5 分钟" Tag="300" />
                                <ComboBoxItem Content="每 10 分钟" Tag="600" />
                                <ComboBoxItem Content="每 30 分钟" Tag="1800" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="立即换一只" Margin="10,0,0,0" Click="RandomizeNow_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BD;" Width="30"/><TextBlock Text="互动词包"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="38,30,38,34" MaxWidth="720" HorizontalAlignment="Stretch">
                        <TextBlock Text="互动词包" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="WordPackSummary" Style="{StaticResource Hint}" Margin="0,0,0,22" />
                        <TextBlock Text="可用词包" Style="{StaticResource FieldLabel}" />
                        <ListBox x:Name="WordPackList" Height="260" Margin="0,0,0,14"
                                 SelectionChanged="WordPackList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                   Style="{StaticResource Hint}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="导入词包" Style="{StaticResource PrimaryButton}"
                                    Click="ImportWords_Click" Margin="0,0,8,0" />
                            <Button x:Name="DeleteWordPackButton" Content="删除所选" Style="{StaticResource DangerButton}"
                                    Click="DeleteWordPack_Click" Margin="0,0,8,0" />
                            <Button Content="格式与 AI 生成" Click="OpenWordPackGuide_Click" />
                        </WrapPanel>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <TextBlock Text="小剧场剧本" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="TheaterScriptSummary" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                        <ListBox x:Name="TheaterScriptList" Height="190" Margin="0,0,0,14"
                                 SelectionChanged="TheaterScriptList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                   Style="{StaticResource Hint}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="导入剧本" Style="{StaticResource PrimaryButton}"
                                    Click="ImportTheaterScript_Click" Margin="0,0,8,0" />
                            <Button x:Name="DeleteTheaterScriptButton" Content="删除所选" Style="{StaticResource DangerButton}"
                                    Click="DeleteTheaterScript_Click" Margin="0,0,8,0" />
                            <Button Content="剧本格式与 AI 生成" Click="OpenTheaterScriptGuide_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" Width="30"/><TextBlock Text="提醒"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="34,28,34,32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="提醒" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="ReminderCountText" Margin="0,0,0,20" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ListBox x:Name="ReminderList" DisplayMemberPath="Display" SelectionChanged="ReminderList_SelectionChanged" />
                        <Button Grid.Row="1" Content="新建提醒" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="NewReminder_Click" />
                    </Grid>
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LineBrush}" Margin="24,0" />
                    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock x:Name="ReminderFormTitle" Text="新建提醒" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16" />
                            <TextBlock Text="日期" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,12" />
                            <TextBlock Text="时间（HH:mm）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReminderTimeText" Text="09:30" MaxLength="5" Margin="0,0,0,12" />
                            <TextBlock Text="提醒内容" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReminderMessageText" Text="休息一下吧" MaxLength="40" Margin="0,0,0,12" />
                            <TextBlock Text="情绪" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ReminderEmotionCombo" Margin="0,0,0,12">
                                <ComboBoxItem Content="开心" Tag="happy" IsSelected="True" />
                                <ComboBoxItem Content="加油" Tag="cheer" />
                                <ComboBoxItem Content="害羞" Tag="shy" />
                                <ComboBoxItem Content="惊讶" Tag="surprised" />
                                <ComboBoxItem Content="生气" Tag="angry" />
                                <ComboBoxItem Content="疑惑" Tag="confused" />
                                <ComboBoxItem Content="难过" Tag="sad" />
                                <ComboBoxItem Content="困倦" Tag="sleepy" />
                                <ComboBoxItem Content="安静" Tag="calm" />
                            </ComboBox>
                            <WrapPanel>
                                <CheckBox x:Name="ReminderEnabledCheck" Content="启用提醒" IsChecked="True" Margin="0,6,24,6" />
                                <CheckBox x:Name="ReminderDailyCheck" Content="每天重复" />
                            </WrapPanel>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="保存提醒" Style="{StaticResource PrimaryButton}" Click="SaveReminder_Click" Margin="0,0,8,0" />
                                <Button x:Name="DeleteReminderButton" Content="删除提醒" Style="{StaticResource DangerButton}" Click="DeleteReminder_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="UpdatesTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" Width="30"/><TextBlock Text="更新"/></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="38,30,38,34" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="软件更新" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="LicenseStatusText" Margin="0,4,0,22" Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}" />
                    <WrapPanel>
                        <CheckBox x:Name="AutoUpdateCheck" Content="自动检查更新" Click="AutoUpdateCheck_Click" Margin="0,6,24,6" />
                        <Button Content="重新激活设备" Click="Reactivate_Click" />
                    </WrapPanel>
                    <Border Margin="0,20,0,16" Padding="18" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UpdateStatusText" FontSize="14" FontWeight="SemiBold" Text="可以检查更新" Foreground="{StaticResource InkBrush}" />
                                <TextBlock x:Name="UpdateNotesText" Margin="0,8,0,0" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel>
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource PrimaryButton}" Click="CheckUpdate_Click" Margin="0,0,8,0" />
                        <Button x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="InstallUpdateButton" Content="更新并重启" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="IgnoreUpdateButton" Content="忽略该版本" Click="IgnoreUpdate_Click" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
