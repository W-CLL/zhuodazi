<article class="article-page">
  <header class="article-hero">
    <div class="site-shell article-hero-inner reveal">
      <a class="back-link" href="<%= url_for('/archives/') %>"><span aria-hidden="true">←</span> 所有文章</a>
      <p class="section-kicker"><%= page.categories && page.categories.length ? page.categories.first().name : '桌搭子手记' %></p>
      <h1><%= page.title %></h1>
      <p class="article-date"><span>作者：<a rel="author" href="<%= url_for('/about/') %>"><%= page.author || config.author %></a></span><span>发布于 <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY 年 MM 月 DD 日') %></time></span><% const updated = editorial_date(page); if (updated && updated !== page.date.toISOString()) { %><span>更新于 <time datetime="<%= updated %>"><%= date(updated, 'YYYY 年 MM 月 DD 日') %></time></span><% } %></p>
    </div>
  </header>
  <div class="site-shell article-layout">
    <aside class="article-aside reveal">
      <% if (page.cover) { %><img src="<%= url_for(page.cover) %>" width="160" height="160" alt="" loading="lazy" decoding="async"><% } %>
      <p>桌搭子手记</p>
      <nav class="article-help" aria-label="相关阅读"><a href="<%= url_for('/faq/') %>">常见问题 →</a><a href="<%= url_for('/activate/') %>">价格与激活 →</a><a href="<%= url_for('/download/') %>">下载最新版 →</a></nav>
    </aside>
    <div class="article-content reveal"><%- page.content %></div>
  </div>
</article>
