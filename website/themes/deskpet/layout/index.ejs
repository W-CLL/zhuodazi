<% const latestPosts = site.posts.sort('date', 'desc').toArray().slice(0, 3); %>
<section class="hero" id="top">
  <div class="site-shell hero-inner">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span></span> 不想发「在吗」的时候</p>
      <h1>桌搭子</h1>
      <p class="hero-lead">对象回「在开会」，你回一只熊。</p>
      <div class="hero-actions">
        <a class="button button-primary" href="<%= url_for('/download/') %>">下载桌搭子 <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href="#play">看看怎么玩</a>
      </div>
      <div class="hero-notes" aria-label="产品特性">
        <span>Windows / macOS / Android</span>
        <span>装上就能先养一只</span>
        <span>电脑版摸鱼能玩七天</span>
      </div>
    </div>
    <div class="desktop-scene reveal" aria-label="原桌宠与搭子发来的 GIF 同时出现在桌面上的示意">
      <div class="scene-wallpaper"></div>
      <div class="scene-topbar"><span></span><span></span><span></span><b>在开会 · 其实在摸鱼</b></div>
      <div class="scene-note note-left">待办<br><strong>先回一只熊</strong></div>
      <div class="scene-note note-right">专注中<br><strong>25:00</strong></div>
      <div class="scene-window scene-window-main">
        <div class="window-heading"><span></span><span></span><span></span><b>下午的工作清单</b></div>
        <div class="window-lines"><i></i><i></i><i></i><i></i></div>
      </div>
      <div class="scene-message" data-speech>搭子发来一张：下班了吗？</div>
      <span class="scene-pet-label scene-pet-label-home">我的桌宠</span>
      <img class="hero-pet hero-pet-home" src="<%= url_for('/images/collection/bubu-home.gif') %>?v=<%= theme.asset_version %>" width="256" height="256" alt="原本待在桌角的白熊桌宠" decoding="async" fetchpriority="high">
      <span class="scene-pet-label scene-pet-label-visitor">搭子送来的 GIF</span>
      <img class="hero-pet-visitor" src="<%= url_for('/images/collection/bubu-visit.gif') %>?v=<%= theme.asset_version %>" width="256" height="256" alt="搭子派来下班的棕熊访客" decoding="async" fetchpriority="high">
      <div class="scene-taskbar"><span></span><span></span><span></span><span></span><b>14:30</b></div>
    </div>
  </div>
</section>

<section class="companion-story" id="play" aria-labelledby="companion-title">
  <div class="site-shell companion-story-inner">
    <div class="companion-story-heading reveal">
      <div>
        <p class="section-kicker">怎么玩</p>
        <h2 id="companion-title">「在吗」太土了。派一只过去坐一会儿。</h2>
      </div>
      <p>不顶聊天气泡，也不赶走原来那只。对方暂时不在，它就在桌角等着。</p>
    </div>

    <div class="companion-flow reveal" aria-label="搭子联机发送流程">
      <article>
        <span>01</span>
        <img src="<%= url_for('/images/collection/bubu-wave.gif') %>" width="128" height="128" alt="挥手打招呼的白熊" loading="lazy" decoding="async">
        <h3>换一对码</h3>
        <p>只跟一个熟人连。共用同一组，你会发现对面是自己。</p>
      </article>
      <i aria-hidden="true">→</i>
      <article>
        <span>02</span>
        <img src="<%= url_for('/images/collection/bubu-send.gif') %>" width="128" height="128" alt="围着围巾准备出发的白熊" loading="lazy" decoding="async">
        <h3>派这张出发</h3>
        <p>起床了吗、抱一下、该下班了。比连续三个问号体面。</p>
      </article>
      <i aria-hidden="true">→</i>
      <article>
        <span>03</span>
        <div class="companion-pair">
          <img src="<%= url_for('/images/collection/bubu-home.gif') %>" width="128" height="128" alt="接收方原来的白熊桌宠" loading="lazy" decoding="async">
          <img src="<%= url_for('/images/collection/bubu-visit.gif') %>" width="128" height="128" alt="搭子派来的棕熊访客" loading="lazy" decoding="async">
        </div>
        <h3>去 TA 桌面坐一会儿</h3>
        <p>自己来，自己走。原来那只还在，不用让座，也不用回。</p>
      </article>
    </div>
  </div>
</section>

<section class="fish-story" id="moyu" aria-labelledby="fish-story-title">
  <div class="site-shell">
    <div class="companion-story-heading reveal">
      <div>
        <p class="section-kicker">右下角这一幕</p>
        <h2 id="fish-story-title">老板回头时，它长得像广告。</h2>
      </div>
      <p>把抖音首页视频放大，打开摸鱼壳，把窗口拖进去。它蹲在右下角，看起来像广告弹窗。文案浮在画面上，不跟视频抢位子。</p>
    </div>

    <div class="fish-story-layout reveal">
      <figure class="fish-proof">
        <img src="<%= url_for('/images/screenshots/fish-mode-real.png') %>?v=<%= theme.asset_version %>" width="438" height="278" alt="摸鱼模式真实运行画面：抖音视频嵌入右下角广告壳" loading="lazy" decoding="async">
      </figure>

      <div class="fish-steps" aria-label="开启摸鱼模式的三个步骤">
        <article>
          <span>01</span>
          <div><h3>先放大视频</h3><p>抖音桌面端首页，把视频放到最大。别急着关。</p></div>
        </article>
        <article>
          <span>02</span>
          <div><h3>打开摸鱼壳</h3><p>它会装成广告弹窗，蹲在电脑右下角。</p></div>
        </article>
        <article>
          <span>03</span>
          <div><h3>把窗口拖进去</h3><p>进去后还能上下滑、点一下、自己播。</p></div>
        </article>
      </div>
    </div>

    <div class="fish-story-footer reveal">
      <div>
        <div class="companion-facts" aria-label="摸鱼模式特性">
          <span>文案浮着，不挤画面</span>
          <span>可挪、可缩、可先藏起来</span>
          <span>关掉壳，视频一起下班</span>
        </div>
        <p class="fish-accessibility">Windows / macOS 第一次能玩七天，激活后继续。macOS 第一次请允许辅助功能，授权后再打开就行。</p>
      </div>
      <a class="button button-primary" href="<%= url_for('/download/') %>">下载电脑版 <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<section class="features" id="features" aria-labelledby="features-title">
  <div class="site-shell">
    <div class="section-heading reveal">
      <p class="section-kicker">桌角还会发生这些</p>
      <h2 id="features-title">它不只会送信。有时候自己也会作妖。</h2>
    </div>
    <div class="feature-grid play-grid">
      <article class="feature reveal">
        <div class="feature-media"><span class="feature-index">01</span><img src="<%= url_for('/images/collection/bubu-walk.gif') %>" width="112" height="112" alt="自己走动的棕熊桌宠" loading="lazy" decoding="async"></div>
        <h3>自己会走动</h3>
        <p>追鼠标、躲开、被你甩出去，再沿屏幕边缘弹回来。像真住这儿。</p>
      </article>
      <article class="feature reveal">
        <div class="feature-media"><span class="feature-index">02</span><img src="<%= url_for('/images/collection/bubu-together.gif') %>" width="112" height="112" alt="两只熊一起趴着玩" loading="lazy" decoding="async"></div>
        <h3>两只一起演一小段</h3>
        <p>靠近、贫两句、换个位置。演完再回来找你，不收门票。</p>
      </article>
      <article class="feature reveal">
        <div class="feature-media"><span class="feature-index">03</span><img src="<%= url_for('/images/collection/bubu-play.gif') %>" width="112" height="112" alt="玩耍的白熊桌宠" loading="lazy" decoding="async"></div>
        <h3>喜欢的 GIF 都能养</h3>
        <p>把透明 GIF 丢进来。今天想换谁就换谁，不用等更新。</p>
      </article>
      <article class="feature reveal">
        <div class="feature-media"><span class="feature-index">04</span><img src="<%= url_for('/images/collection/bubu-remind.gif') %>" width="112" height="112" alt="带着下班表情来叫你的白熊" loading="lazy" decoding="async"></div>
        <h3>到点换个表情来叫你</h3>
        <p>提醒不必弹窗。它带着那张图出现，比闹钟会做人。</p>
      </article>
    </div>
  </div>
</section>

<section class="client-showcase" aria-labelledby="client-showcase-title">
  <div class="site-shell">
    <div class="client-showcase-heading reveal">
      <div>
        <p class="section-kicker">打开后大概是这样</p>
        <h2 id="client-showcase-title">它们会自己演，也会来找你。</h2>
      </div>
      <p>先看两只演完一小段，再接住它丢过来的那句话。不回也行。</p>
    </div>
    <div class="client-shot-grid client-scene-grid">
      <figure class="client-shot reveal">
        <img src="<%= url_for('/images/screenshots/visit-showcase.gif') %>?v=<%= theme.asset_version %>" width="1200" height="760" alt="白熊待在桌角，棕熊带着下班表情来串门" loading="lazy" decoding="async">
        <figcaption><strong>搭子来串门</strong><span>原来那只还在，访客自己找地方坐</span></figcaption>
      </figure>
      <figure class="client-shot reveal">
        <img src="<%= url_for('/images/screenshots/together-showcase.gif') %>?v=<%= theme.asset_version %>" width="1200" height="760" alt="两只熊在小剧场里对白，约对方坐一会儿" loading="lazy" decoding="async">
        <figcaption><strong>两只一起待一会儿</strong><span>靠近、贫两句，演完一小段</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="download-band" aria-labelledby="download-band-title">
  <div class="site-shell download-band-inner reveal">
    <div>
      <p class="section-kicker">下完就能养</p>
      <h2 id="download-band-title">先把一只养在桌角。</h2>
      <p>Windows <span data-release-version="windows/x64">最新版</span>、macOS <span data-release-version="macos/arm64">最新版</span>，手机也能下 Android <span data-release-version="android/arm64-v8a">最新版</span>。想给对方发 GIF，打开设置里的「搭子」，换一对码。</p>
    </div>
    <a class="button button-primary" href="<%= url_for('/download/') %>">去下载 <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="journal" id="journal">
  <div class="site-shell">
    <div class="journal-heading reveal">
      <div>
        <p class="section-kicker">手记</p>
        <h2>最近记下的几件小事。</h2>
      </div>
      <a class="text-link" href="<%= url_for('/archives/') %>">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      <% latestPosts.forEach(function(post) { %>
        <article class="post-card reveal">
          <a class="post-card-image" href="<%= url_for(post.path) %>" aria-label="阅读 <%= post.title %>">
            <img src="<%= url_for(post.cover || '/images/pet-work.gif') %>" width="160" height="160" alt="" loading="lazy" decoding="async">
          </a>
          <div class="post-card-copy">
            <div class="post-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span><%= post.categories && post.categories.length ? post.categories.first().name : '桌搭子手记' %></span></div>
            <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
            <p><%= post.excerpt || truncate(strip_html(post.content), {length: 82}) %></p>
            <a class="post-read" href="<%= url_for(post.path) %>">阅读全文 <span aria-hidden="true">→</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
