<%
const shots = {
  hello: [973,588,'桌宠弹出关怀互动，提醒忙碌中的你休息一下'],
  lyrics: [325,391,'听歌词猜歌名，点击选项回答'], score: [295,367,'答对后出现答案和收下这分按钮'],
  quiz: [1018,563,'桌面上的选择题互动'], theater: [792,373,'两只桌宠轮流说台词的小剧场'],
  visit: [633,319,'另一只桌宠带着留言来访，原桌宠仍在'], hall: [707,313,'桌宠大厅的公开在线开关和在线用户列表'],
  personality: [647,417,'性格、随机走动、鼠标跟随和互动频率设置'], reminder: [764,499,'设置点外卖和休息提醒的时间与内容'],
  words: [363,348,'自定义词包让桌宠说出不同风格的台词'], break: [1440,916,'电脑桌面右下角的摸鱼视频小窗口']
};
function shot(name, eager) {
 const s = shots[name];
 return `<a class="real-shot" href="${url_for('/images/promo/'+name+'.webp')}" data-lightbox aria-label="放大查看：${s[2]}"><img src="${url_for('/images/promo/'+name+'.webp')}" width="${s[0]}" height="${s[1]}" alt="${s[2]}" ${eager ? 'fetchpriority="high"' : 'loading="lazy"'} decoding="async"><span class="zoom-hint" aria-hidden="true">查看大图 ↗</span></a>`;
}
%>
<noscript><style>.scene-tabs{display:none}.scene-panel[hidden]{display:grid!important}</style></noscript>
<div class="home-redesign">
<section class="welcome-section" id="top">
  <div class="site-shell welcome-grid">
    <div class="welcome-copy">
      <a class="release-pill" href="<%= url_for('/posts/deskpet-3-3-update/') %>"><span></span> 新朋友报到 · 20 只默认桌宠 <b aria-hidden="true">↗</b></a>
      <p class="welcome-label">桌搭子 · 住在屏幕上的小伙伴</p>
      <h1>屏幕这么大，<br>分它一个<span>小角落。</span></h1>
      <p class="welcome-description">写东西、赶进度、发会儿呆，身边多一只小桌宠。<br class="desktop-break">陪你走走，接个梗，演段小剧场；也能带着留言，去别人的屏幕串个门。</p>
      <div class="welcome-actions"><a class="button button-primary" href="<%= url_for('/download/') %>">领一只桌搭子 <span aria-hidden="true">↓</span></a><a class="button button-secondary" href="#play">看看它会什么 <span aria-hidden="true">↘</span></a></div>
      <p class="welcome-footnote">Windows / macOS / Android 桌面宠物 · 基础陪伴免费<br>首次 7 天进阶体验 · <a href="<%= url_for('/activate/') %>"><%= site.data.product.activation.price %> 元一次购买，永久激活 →</a></p>
    </div>
    <div class="welcome-visual">
      <div class="scene-topline"><span><i></i> 屏幕上的一小段日常</span><span>REAL MOMENTS / 01</span></div>
      <%- shot('hello', true) %>
      <div class="scene-caption"><span>忙了一阵，它来叫你歇一歇。</span><span>真实使用画面</span></div>
      <div class="welcome-sticker"><img src="<%= url_for('/images/collection/bubu-wave.gif') %>" width="80" height="80" alt="挥手的白熊桌宠"><span>今天也一起<br><strong>好好摸个小鱼。</strong></span></div>
    </div>
  </div>
  <div class="site-shell little-facts"><span><b>20 只</b> 默认桌宠，先挑喜欢的</span><span><b>一个人</b> 也能互动、看小剧场</span><span><b>想热闹</b> 体验期就能去大厅串门</span><span><b>想安静</b> 暂停主动打扰一小时</span></div>
</section>
<section class="home-section play-section" id="play" aria-labelledby="play-title">
  <div class="site-shell">
    <div class="home-heading"><div><p class="overline">01 / 一个人，也有小热闹</p><h2 id="play-title">不只是动一动。<br>它还会和你玩一会儿。</h2></div><p>不用先找好友，也不用准备素材。<br>从一次互动、一段内置小剧场开始。</p></div>
    <div class="scene-tabs" role="tablist" aria-label="查看桌宠玩法">
      <button id="tab-quiz" role="tab" aria-selected="true" aria-controls="scene-quiz" data-scene="quiz">01 猜一题，接个梗</button>
      <button id="tab-theater" role="tab" aria-selected="false" aria-controls="scene-theater" tabindex="-1" data-scene="theater">02 看两只演小剧场</button>
      <button id="tab-hello" role="tab" aria-selected="false" aria-controls="scene-hello" tabindex="-1" data-scene="hello">03 收到一点小关心</button>
    </div>
    <div class="scene-panel" id="scene-quiz" role="tabpanel" aria-labelledby="tab-quiz" tabindex="0">
      <div class="scene-copy"><span class="feature-tag">趣味互动</span><h3>这首歌，你肯定听过。</h3><p>猜歌词、答题、脑筋急转弯，点选答案就能参与。答对了，再收下这一分。</p><ol class="compact-steps"><li>打开「灵感口袋」或手机「互动」页</li><li>手动来一次互动，看看这次抽到什么</li><li>喜欢热闹，也可以开启自动互动</li></ol><p class="small-note">内容会随机出现；这是趣味问答，不是自由输入的 AI 聊天。</p><details class="extra-shot"><summary>再看一张答题画面</summary><%- shot('quiz') %></details></div>
      <div class="quiz-pair"><figure><%- shot('lyrics') %><figcaption>选一个答案</figcaption></figure><span class="quiz-arrow" aria-hidden="true">→</span><figure><%- shot('score') %><figcaption>答对，收下这分！</figcaption></figure></div>
    </div>
    <div class="scene-panel" id="scene-theater" role="tabpanel" aria-labelledby="tab-theater" tabindex="0" hidden>
      <div class="scene-copy"><span class="feature-tag">双宠小剧场</span><h3>它俩演，你负责围观。</h3><p>两只桌宠轮流说台词，把普通的一天演成一小段故事。不用绑定真人好友，也不用先导入剧本。</p><ol class="compact-steps"><li>打开「小剧场」，手动演一次</li><li>喜欢这份热闹，再开启自动上演</li><li>电脑端还可以导入自己的小剧本</li></ol><p class="small-note">Android 上，两只桌宠在屏幕上方一左一右轮流说话。</p></div><figure><%- shot('theater') %><figcaption>内置对白就能开演，一个人也能看。</figcaption></figure>
    </div>
    <div class="scene-panel" id="scene-hello" role="tabpanel" aria-labelledby="tab-hello" tabindex="0" hidden>
      <div class="scene-copy"><span class="feature-tag">陪伴日常</span><h3>歇一下，也算今天的进度。</h3><p>日常小台词、心情问候、笑话和关怀，让屏幕角落多一点回应。互动频率可以调，日常台词也能单独关。</p><ol class="compact-steps"><li>选择舒服的互动频率</li><li>想玩时，自己叫它来一条</li><li>忙起来，暂停主动打扰一小时</li></ol><p class="small-note">暂停会暂缓主动台词、自动互动、自动剧场和来访展示；手动玩法与提醒仍可用。</p></div><figure><%- shot('hello') %><figcaption>一点小关心，留给忙碌中的你。</figcaption></figure>
    </div>
    <p class="screenshot-note">画面来自电脑端实际使用。角色、台词和设置名称以当前版本为准；点击图片可放大。</p>
  </div>
</section>
<section class="home-section hall-section" id="hall" aria-labelledby="hall-title">
  <div class="site-shell hall-grid">
    <div class="hall-visual"><figure><%- shot('visit') %><figcaption>它带着留言来了，你原来的桌宠还在。</figcaption></figure><figure class="hall-ui"><%- shot('hall') %><figcaption>主动加入大厅，看看谁也在线。</figcaption></figure></div>
    <div class="hall-copy"><p class="overline">02 / 把一点开心，送到另一块屏幕</p><h2 id="hall-title">不用问「在吗」，<br>派一只过去看看。</h2><p>挑一个在线的人，把当前桌宠和一句留言送过去。对方的屏幕上，就多了一位短暂停留的小客人。</p>
      <div class="access-box"><span class="feature-tag">有效体验期就能玩</span><h3>桌宠大厅：和在线的人打个招呼</h3><p>在设置中打开桌宠大厅 → 主动公开在线 → 选择接收人 → 发送桌宠和留言。是否加入由你决定，随时可以退出。</p></div>
      <div class="private-note"><h3>想和熟人长期配对？</h3><p>双方正式激活后，用 <strong>8 位搭子码</strong>绑定私人搭子。<strong>6 位激活码</strong>用来授权设备，不是配对码；同一激活码下的两台设备属于同一账号。</p></div>
      <a class="text-link" href="<%= url_for('/download/') %>">先体验大厅，再认识一个新搭子 →</a>
    </div>
  </div>
</section>
<section class="home-section" id="everyday" aria-labelledby="everyday-title">
  <div class="site-shell"><div class="home-heading"><div><p class="overline">03 / 陪伴的样子，由你来定</p><h2 id="everyday-title">有点性格，也懂分寸。</h2></div><p>想黏人一点，还是安静一点？<br>把它调成你喜欢的日常。</p></div>
    <div class="everyday-grid">
      <article><div class="everyday-image"><%- shot('personality') %></div><span class="card-number">01 / 行为与性格</span><h3>让它跟着走，或自己溜达。</h3><p>活泼、害羞、黏人、混乱，四种性格可选。电脑支持跟随和躲避鼠标，也能单独关闭走动。</p></article>
      <article><div class="everyday-image"><%- shot('reminder') %></div><span class="card-number">02 / 贴心提醒</span><h3>到点了，叫你记得吃饭。</h3><p>填好时间和文字，可设每天重复，再配一张 GIF。点外卖、喝水、歇一歇，让桌宠来提醒。</p><p class="small-note">提醒需要应用保持运行，退出或系统休眠会影响触发。</p></article>
      <article><div class="everyday-image word-image"><%- shot('words') %></div><span class="card-number">03 / 自定义台词</span><h3>嘴甜一点，还是皮一点？</h3><p>选择内置词包，换一种说话风格。Windows / macOS 还支持导入自己的词包；Android 使用内置词包。</p><a class="text-link" href="<%= url_for('/resources/') %>">去挑一套词包或剧本 →</a></article>
    </div>
    <details class="break-details" id="moyu"><summary><span><span class="feature-tag">电脑端限定</span><strong>工作间隙，再留一个摸鱼小窗口。</strong></span><span class="details-label">展开看看 <b aria-hidden="true">＋</b></span></summary><div class="break-content"><%- shot('break') %><div><h3>视频搬到桌角，歇一会儿。</h3><p>在抖音桌面端打开视频，从桌搭子打开摸鱼窗口，再按提示把视频窗口拖进去。</p><p>Windows / macOS 有效体验或正式激活后可用，Android 不支持。macOS 首次使用需允许辅助功能；关闭摸鱼窗口会同时关闭嵌入的视频窗口。</p></div></div></details>
  </div>
</section>
<section class="home-section platforms-section" id="platforms" aria-labelledby="platforms-title"><div class="site-shell">
  <div class="home-heading"><div><p class="overline">04 / 电脑上，手机上，都有个小角落</p><h2 id="platforms-title">同一份陪伴，三种打开方式。</h2></div><a class="text-link" href="<%= url_for('/posts/deskpet-3-3-update/') %>">查看本次更新 →</a></div>
  <div class="platform-intros"><article><span class="platform-symbol">⊞</span><h3>Windows</h3><p>拖动、双击、右键桌宠，<br>托盘里也能找到它。</p><span data-release-version="windows/x64">v最新版</span></article><article><span class="platform-symbol">⌘</span><h3>macOS</h3><p>拖动、右键操作，<br>菜单栏里随时找回它。</p><span data-release-version="macos/arm64">v最新版</span></article><article><span class="platform-symbol">↗</span><h3>Android</h3><p>允许悬浮显示后启动，<br>点桌宠打开常用菜单。</p><span data-release-version="android/arm64-v8a">v最新版</span></article></div>
  <p class="mobile-table-hint small-note">左右滑动表格，查看全部平台 →</p>
  <div class="comparison-scroll" tabindex="0" role="region" aria-label="三端功能对比，可横向滚动"><table class="comparison-table"><caption>选版本前，先看这些差异</caption><thead><tr><th scope="col">你想玩的</th><th scope="col">Windows</th><th scope="col">macOS</th><th scope="col">Android</th></tr></thead><tbody>
    <tr><th scope="row">20 只默认桌宠、拖动与换宠</th><td>支持</td><td>支持</td><td>支持</td></tr>
    <tr><th scope="row">互动、小剧场、提醒、大厅</th><td>有效体验 / 激活</td><td>有效体验 / 激活</td><td>有效体验 / 激活</td></tr>
    <tr><th scope="row">跟随 / 躲避鼠标</th><td>支持</td><td>支持</td><td>不支持</td></tr>
    <tr><th scope="row">导入自己的 GIF（最多 3 个）</th><td>基础陪伴可用</td><td>基础陪伴可用</td><td>需正式激活</td></tr>
    <tr><th scope="row">导入自定义词包</th><td>支持</td><td>支持</td><td>选择内置词包</td></tr>
    <tr><th scope="row">摸鱼窗口</th><td>支持</td><td>支持，需辅助功能权限</td><td>不支持</td></tr>
    <tr><th scope="row">绑定私人搭子</th><td>需正式激活</td><td>需正式激活</td><td>需正式激活</td></tr>
  </tbody></table></div><p class="small-note">词包导入、摸鱼等进阶功能需有效体验或激活。大厅需联网；手机悬浮与后台运行还受系统权限和省电策略影响。当前没有 iOS 版。</p>
</div></section>
<section class="home-section start-section" id="start" aria-labelledby="start-title"><div class="site-shell"><div class="home-heading"><div><p class="overline">05 / 今天，就从一只开始</p><h2 id="start-title">不用做功课，跟着它玩一遍。</h2></div><p>首次使用有引导，可跳过，也能重看。<br>先玩懂，再决定要不要让它常住。</p></div><ol class="start-steps"><li><span>1</span><h3>下对版本，叫它出来</h3><p>按设备选择安装包。Android 先允许「显示在其他应用上层」。</p></li><li><span>2</span><h3>互动一次，看段小剧场</h3><p>跟着引导认识操作，试试内置玩法，学会暂停和找回。</p></li><li><span>3</span><h3>换只喜欢的，去大厅逛逛</h3><p>20 只默认桌宠任选。有效体验期内，可主动加入大厅发送桌宠和留言。</p></li></ol>
  <div class="start-cta"><div><h3>给今天，添一个小搭子。</h3><p>首次 7 天进阶体验 · 到期保留基础陪伴</p></div><a class="button button-primary" href="<%= url_for('/download/') %>">免费下载体验 <span aria-hidden="true">↓</span></a></div>
  <div class="home-faq"><details><summary>一定要买了才能养吗？</summary><p>不用。下载后可使用基础陪伴，首次有 7 天进阶体验。体验结束后基础陪伴仍保留；私人搭子绑定和 Android 导入自己的 GIF 需要正式激活。</p></details><details><summary>会一直说话、挡住工作吗？</summary><p>可以分别调整自动互动、日常台词、走动和自动小剧场。忙的时候暂停主动打扰一小时，也可以隐藏桌宠。关闭设置页不会退出应用，完全退出请用托盘、菜单栏或手机对应入口。</p></details><details><summary>大厅和私人搭子有什么不同？</summary><p>大厅面向主动公开在线的用户，有效体验期间即可发送桌宠和留言。私人搭子用于与熟人长期配对，双方需要正式激活；不是用同一组激活码互相配对。</p></details></div>
  <div class="reading-links"><span>想再了解一点？</span><a href="<%= url_for('/posts/deskpet-feature-guide/') %>">完整玩法指南 ↗</a><a href="<%= url_for('/faq/') %>">常见问题 ↗</a><a href="<%= url_for('/activate/') %>">激活价格与授权 ↗</a><a href="<%= url_for('/archives/') %>">桌搭子手记 ↗</a></div>
</div></section>
</div>
