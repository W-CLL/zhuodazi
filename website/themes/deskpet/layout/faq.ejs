<section class="answers-page">
  <header class="site-shell answers-header">
    <p class="section-kicker">使用前，先把这些弄明白</p>
    <h1>桌搭子常见问题</h1>
    <p><%= site.data.product.description %></p>
    <p><%= site.data.product.free.description %> <%= site.data.product.activation.description %></p>
  </header>
  <div class="site-shell answers-layout">
    <nav class="answers-index" aria-label="问题目录">
      <p>找到你关心的问题</p>
      <ol><% site.data.questions.forEach(function(item) { %>
        <li><a href="#<%= item.id %>"><%= item.question %></a></li>
      <% }) %></ol>
    </nav>
    <div class="answers-content">
      <% site.data.questions.forEach(function(item) { %>
      <section class="answer-entry" id="<%= item.id %>" aria-labelledby="<%= item.id %>-title">
        <h2 id="<%= item.id %>-title"><%= item.question %></h2>
        <p><%= item.answer %></p>
        <a class="text-link" href="<%= url_for(item.link) %>"><%= item.link_label %> →</a>
      </section>
      <% }) %>
    </div>
  </div>
</section>
