<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="<%= page.description || config.description %>">
    <meta name="theme-color" content="#f6f8f6">
    <meta name="color-scheme" content="light dark">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page.title ? page.title + ' | ' + config.title : config.title %>">
    <meta property="og:description" content="<%= page.description || config.description %>">
    <meta property="og:url" content="<%= config.url + url_for(page.path || '/') %>">
    <meta property="og:image" content="<%= config.url + url_for('/images/pet-work.gif') %>">
    <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
    <link rel="icon" href="<%= url_for('/images/app-icon.png') %>" type="image/png">
    <link rel="stylesheet" href="<%= url_for('/css/site.css') %>?v=<%= theme.asset_version %>">
  </head>
  <body class="page-<%= page.layout || 'default' %>">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-site-header>
      <div class="site-shell header-inner">
        <a class="brand" href="<%= url_for('/') %>" aria-label="桌搭子首页">
          <img src="<%= url_for('/images/app-icon.png') %>" width="38" height="38" alt="">
          <span>桌搭子</span>
        </a>
        <nav class="site-nav" id="site-navigation" aria-label="主导航" data-site-nav>
          <a href="<%= url_for('/') %>">首页</a>
          <a href="<%= url_for('/#features') %>">功能</a>
          <a href="<%= url_for('/#customize') %>">素材与互动</a>
          <a href="<%= url_for('/resources/') %>">资源包</a>
          <a href="<%= url_for('/download/') %>">下载</a>
          <a href="<%= url_for('/archives/') %>">动态</a>
          <a href="<%= url_for('/about/') %>">关于</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button theme-button" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">
            <span aria-hidden="true">◐</span>
          </button>
          <button class="icon-button menu-button" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation" aria-label="打开导航菜单" title="打开导航菜单">
            <span aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <%- body %>
    </main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div>
          <a class="brand footer-brand" href="<%= url_for('/') %>">
            <img src="<%= url_for('/images/app-icon.png') %>" width="34" height="34" alt="">
            <span>桌搭子</span>
          </a>
          <p>让屏幕边角多一份刚好的陪伴。</p>
        </div>
        <div class="footer-links">
          <a href="<%= url_for('/download/') %>">下载安装</a>
          <a href="<%= url_for('/resources/') %>">互动资源</a>
          <a href="<%= url_for('/archives/') %>">产品动态</a>
          <a href="<%= url_for('/about/') %>">关于我们</a>
        </div>
      </div>
      <div class="site-shell footer-meta">
        <span>&copy; <%= new Date().getFullYear() %> DeskPet. Built with care.</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备2026106104号</a>
      </div>
    </footer>
    <script src="<%= url_for('/js/site.js') %>?v=<%= theme.asset_version %>" defer></script>
  </body>
</html>
