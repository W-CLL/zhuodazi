<!doctype html>
<%
  const siteUrl = String(config.url || 'https://desktoppet.online').replace(/\/$/, '');
  const pagePath = url_for(page.path || '/');
  const canonicalUrl = siteUrl + (pagePath === '/index.html' ? '/' : pagePath);
  const isHome = Boolean(page.__index) || page.path === '' || page.path === 'index.html';
  const isPost = page.layout === 'post';
  const isNotFound = String(page.path || '').includes('404');
  const isArchive = Boolean(page.archive) || page.layout === 'archive';
  const seoTitle = isHome
    ? '桌搭子｜对象回「在开会」，你回一只熊'
    : isArchive
      ? '桌搭子手记｜桌角发生过的事'
      : ((page.title || config.title) + '｜桌搭子');
  const fallbackDescription = isArchive
    ? '桌搭子手记。怎么用、改了什么、以及那次把熊派过去之后发生了什么。'
    : config.description;
  const seoDescription = String(strip_html(page.description || page.excerpt || fallbackDescription || ''))
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 180);
  const seoImage = siteUrl + url_for(page.cover || '/images/screenshots/visit-showcase.gif');
  const ogType = isPost ? 'article' : 'website';
  const softwareLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: '桌搭子',
    alternateName: 'DeskPet',
    applicationCategory: 'EntertainmentApplication',
    operatingSystem: 'Windows, macOS, Android',
    url: siteUrl + '/',
    downloadUrl: siteUrl + '/download/',
    description: config.description,
    image: siteUrl + url_for('/images/screenshots/visit-showcase.gif'),
    offers: {
      '@type': 'Offer',
      url: siteUrl + '/download/',
      price: '0',
      priceCurrency: 'CNY',
      description: '先下载试用。一组激活码填两台。'
    }
  };
  const webpageLd = {
    '@context': 'https://schema.org',
    '@type': isPost ? 'BlogPosting' : 'WebPage',
    name: seoTitle,
    headline: page.title || seoTitle,
    description: seoDescription,
    url: canonicalUrl,
    inLanguage: 'zh-CN',
    isPartOf: { '@type': 'WebSite', name: '桌搭子', url: siteUrl + '/' },
    image: seoImage
  };
  if (isPost && page.date) webpageLd.datePublished = page.date.toISOString();
  if (isPost && page.updated) webpageLd.dateModified = page.updated.toISOString();
%>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= seoTitle %></title>
    <meta name="description" content="<%= seoDescription %>">
    <meta name="keywords" content="<%= config.keywords %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta name="theme-color" content="#f6f8f6">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="<%= isNotFound ? 'noindex,follow' : 'index,follow' %>">
    <meta property="og:type" content="<%= ogType %>">
    <meta property="og:locale" content="zh_CN">
    <meta property="og:site_name" content="桌搭子">
    <meta property="og:title" content="<%= seoTitle %>">
    <meta property="og:description" content="<%= seoDescription %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:image" content="<%= seoImage %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seoTitle %>">
    <meta name="twitter:description" content="<%= seoDescription %>">
    <meta name="twitter:image" content="<%= seoImage %>">
    <link rel="icon" href="<%= url_for('/images/app-icon.png') %>" type="image/png">
    <link rel="stylesheet" href="<%= url_for('/css/site.css') %>?v=<%= theme.asset_version %>">
    <script type="application/ld+json"><%- JSON.stringify(isHome ? softwareLd : webpageLd) %></script>
    <% if (isHome) { %><script type="application/ld+json"><%- JSON.stringify(webpageLd) %></script><% } %>
  </head>
  <body class="page-<%= page.layout || 'default' %>">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-site-header>
      <div class="site-shell header-inner">
        <a class="brand" href="<%= url_for('/') %>" aria-label="桌搭子首页">
          <img src="<%= url_for('/images/app-icon.png') %>" width="38" height="38" alt="" decoding="async">
          <span>桌搭子</span>
        </a>
        <nav class="site-nav" id="site-navigation" aria-label="主导航" data-site-nav>
          <a href="<%= url_for('/') %>">首页</a>
          <a href="<%= url_for('/#play') %>">怎么玩</a>
          <a href="<%= url_for('/#moyu') %>">摸鱼</a>
          <a href="<%= url_for('/download/') %>">下载</a>
          <a href="<%= url_for('/resources/') %>">资源包</a>
          <a href="<%= url_for('/archives/') %>">手记</a>
          <a href="<%= url_for('/about/') %>">关于</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button theme-button" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">
            <span aria-hidden="true">◐</span>
          </button>
          <button class="icon-button menu-button" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation" aria-label="打开导航菜单" title="打开导航菜单">
            <span aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <%- body %>
    </main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div>
          <a class="brand footer-brand" href="<%= url_for('/') %>">
            <img src="<%= url_for('/images/app-icon.png') %>" width="34" height="34" alt="" loading="lazy" decoding="async">
            <span>桌搭子</span>
          </a>
          <p>对象回「在开会」，你回一只熊。</p>
        </div>
        <div class="footer-links">
          <a href="<%= url_for('/download/') %>">下载</a>
          <a href="<%= url_for('/resources/') %>">资源包</a>
          <a href="<%= url_for('/archives/') %>">手记</a>
          <a href="<%= url_for('/about/') %>">关于</a>
          <a data-xianyu-link hidden href="https://www.goofish.com/" target="_blank" rel="noopener">闲鱼</a>
        </div>
      </div>
      <div class="site-shell footer-meta">
        <span>&copy; <%= new Date().getFullYear() %> DeskPet. Built with care.</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备2026106104号</a>
      </div>
      <div class="site-shell footer-disclaimer">GIF 资源均来自网络公开，如有侵权请联系删除</div>
    </footer>
    <script src="<%= url_for('/js/site.js') %>?v=<%= theme.asset_version %>" defer></script>
  </body>
</html>
