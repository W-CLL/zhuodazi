<!doctype html>
<%
  const info = discovery_info(page);
  const canonicalUrl = info.canonical;
  const isPost = page.layout === 'post';
  const seoTitle = info.title;
  const seoDescription = String(strip_html(info.description || ''))
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 180);
  const seoImage = full_url_for(page.cover || '/images/promo/hello.webp');
  const ogType = isPost ? 'article' : 'website';
  const modifiedDate = editorial_date(page);
%>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= seoTitle %></title>
    <meta name="description" content="<%= seoDescription %>">
    <meta name="keywords" content="<%= config.keywords %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta name="theme-color" content="#faf9f3">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="<%= info.is404 ? 'noindex,follow' : 'index,follow,max-image-preview:large' %>">
    <meta property="og:type" content="<%= ogType %>">
    <meta property="og:locale" content="zh_CN">
    <meta property="og:site_name" content="桌搭子">
    <meta property="og:title" content="<%= seoTitle %>">
    <meta property="og:description" content="<%= seoDescription %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:image" content="<%= seoImage %>">
    <meta property="og:image:alt" content="桌搭子桌面宠物与互动玩法">
    <% if (isPost) { %>
    <meta name="author" content="<%= page.author || config.author %>">
    <meta property="article:published_time" content="<%= date_xml(page.date) %>">
    <% if (modifiedDate) { %><meta property="article:modified_time" content="<%= modifiedDate %>"><% } %>
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seoTitle %>">
    <meta name="twitter:description" content="<%= seoDescription %>">
    <meta name="twitter:image" content="<%= seoImage %>">
    <link rel="icon" href="<%= url_for('/images/app-icon.png') %>" type="image/png">
    <link rel="alternate" type="text/plain" title="桌搭子官方信息索引" href="<%= url_for('/llms.txt') %>">
    <link rel="stylesheet" href="<%= url_for('/css/site.css') %>?v=<%= theme.asset_version %>">
    <link rel="stylesheet" href="<%= url_for('/css/product.css') %>?v=<%= theme.asset_version %>">
    <script type="application/ld+json"><%- discovery_json(page, info, seoDescription, seoImage) %></script>
  </head>
  <body class="page-<%= page.layout || 'default' %>">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header" data-site-header>
      <div class="site-shell header-inner">
        <a class="brand" href="<%= url_for('/') %>" aria-label="桌搭子首页">
          <img src="<%= url_for('/images/app-icon.png') %>" width="38" height="38" alt="" decoding="async">
          <span>桌搭子</span>
        </a>
        <nav class="site-nav" id="site-navigation" aria-label="主导航" data-site-nav>
          <a href="<%= url_for('/') %>">首页</a>
          <a href="<%= url_for('/#play') %>">怎么玩</a>
          <a href="<%= url_for('/#platforms') %>">三端对比</a>
          <a href="<%= url_for('/resources/') %>">资源包</a>
          <a href="<%= url_for('/activate/') %>">激活说明</a>
          <a href="<%= url_for('/archives/') %>">手记</a>
          <a class="nav-download" href="<%= url_for('/download/') %>">免费下载 ↓</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button theme-button" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">
            <span aria-hidden="true">◐</span>
          </button>
          <button class="icon-button menu-button" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation" aria-label="打开导航菜单" title="打开导航菜单">
            <span aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <% if (!info.isHome && !info.is404) { %>
      <nav class="site-shell breadcrumbs" aria-label="面包屑导航">
        <ol><% info.crumbs.forEach(function(crumb, index) { %>
          <li><% if (index === info.crumbs.length - 1) { %><span aria-current="page"><%= crumb.name %></span><% } else { %><a href="<%= crumb.url %>"><%= crumb.name %></a><% } %></li>
        <% }) %></ol>
      </nav>
      <% } %>
      <%- body %>
    </main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div>
          <a class="brand footer-brand" href="<%= url_for('/') %>">
            <img src="<%= url_for('/images/app-icon.png') %>" width="34" height="34" alt="" loading="lazy" decoding="async">
            <span>桌搭子</span>
          </a>
          <p>给日常添一点小热闹，给屏幕留一个小搭子。</p>
        </div>
        <div class="footer-links">
          <a href="<%= url_for('/download/') %>">下载</a>
          <a href="<%= url_for('/activate/') %>">激活说明</a>
          <a href="<%= url_for('/faq/') %>">常见问题</a>
          <a href="<%= url_for('/posts/deskpet-feature-guide/') %>">玩法指南</a>
          <a href="<%= url_for('/resources/') %>">资源包</a>
          <a href="<%= url_for('/archives/') %>">手记</a>
          <a href="<%= url_for('/about/') %>">关于</a>
          <a data-xianyu-link hidden href="https://www.goofish.com/" target="_blank" rel="noopener">闲鱼</a>
        </div>
      </div>
      <div class="site-shell footer-meta">
        <span>&copy; <%= new Date().getFullYear() %> DeskPet. Built with care.</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">粤ICP备2026106104号</a>
      </div>
      <div class="site-shell footer-disclaimer">GIF 资源均来自网络公开，如有侵权请联系删除</div>
    </footer>
    <script src="<%= url_for('/js/site.js') %>?v=<%= theme.asset_version %>" defer></script>
    <script src="<%= url_for('/js/product.js') %>?v=<%= theme.asset_version %>" defer></script>
  </body>
</html>
