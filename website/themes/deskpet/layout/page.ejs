<section class="article-page">
  <header class="article-hero compact-hero">
    <div class="site-shell article-hero-inner reveal">
      <p class="section-kicker">DESKPET</p>
      <h1><%= page.title %></h1>
      <% if (page.subtitle) { %><p class="article-date"><%= page.subtitle %></p><% } %>
    </div>
  </header>
  <div class="site-shell article-layout page-layout">
    <div class="article-content reveal"><%- page.content %></div>
  </div>
</section>
