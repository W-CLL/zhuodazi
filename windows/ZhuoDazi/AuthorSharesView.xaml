<UserControl x:Class="ZhuoDazi.AuthorSharesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="View_Loaded">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="作者分享" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#29443C"/>
   <DockPanel Margin="0,0,0,16">
    <Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click" Padding="14,6" Margin="12,0,0,0"/>
    <ComboBox x:Name="Categories" DisplayMemberPath="Name" SelectionChanged="Category_Changed" MinWidth="180"/>
   </DockPanel>
   <TextBlock x:Name="Status" Text="正在加载…" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#66766F"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="Links">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Button Tag="{Binding}" Click="Link_Click" HorizontalContentAlignment="Stretch" Padding="18" Margin="0,0,0,12" Background="#F2F6F3" BorderBrush="#DFE7E0">
       <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#29443C" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Description}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#52645C"/>
        <TextBlock Text="{Binding Url}" Margin="0,8,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#66766F"/>
       </StackPanel>
      </Button>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </DockPanel>
</UserControl>
