<Window x:Class="ZhuoDazi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZhuoDazi.Controls"
        Title="桌搭子设置" Width="1000" Height="720" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F7F9F8" ShowInTaskbar="True"
        Icon="pack://application:,,,/assets/app-icon.png" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="NavBrush" Color="#F1F5F3" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#DCEFE9" />
        <SolidColorBrush x:Key="HoverBrush" Color="#E7EFEC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftBrush" Color="#EEF4F1" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84640" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="#FFF9F8" />
            <Setter Property="BorderBrush" Value="#E8C9C6" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="#AEBAB6" BorderThickness="1">
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 15,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" CornerRadius="5" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#EFF4F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="#0E695A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Width" Value="166" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#46504D" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavItem" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Border x:Name="SelectionBar" Width="3" Height="24" CornerRadius="2"
                                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                        Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavItem" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#0F6C5D" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionDivider" TargetType="Separator">
            <Setter Property="Margin" Value="0,18" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>

        <Style x:Key="SurfacePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,4,18,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabs" SelectedIndex="0" TabStripPlacement="Left" Background="#F7F9F8" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="186" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                            <TabPanel IsItemsHost="True" Margin="0,16,0,0" />
                        </Border>
                        <Border Grid.Column="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem x:Name="AppearanceTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" Width="30"/><TextBlock Text="外观与行为"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Text="外观与行为" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="调整桌搭子的显示方式和日常活动" Style="{StaticResource Hint}" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SurfacePanel}" Padding="20,16">
                            <StackPanel>
                                <Grid MinHeight="54">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="桌宠大小" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="调整桌面上的显示尺寸" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="SizeSlider" Height="30" Minimum="140" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged" />
                                        <TextBlock x:Name="SizeValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </Grid>

                                <Separator Margin="0,13" Background="{StaticResource LineBrush}" />
                                <Grid MinHeight="54">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="透明度" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="降低存在感或保持清晰显示" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="OpacitySlider" Height="30" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
                                        <TextBlock x:Name="OpacityValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </Grid>

                                <Separator Margin="0,13" Background="{StaticResource LineBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="随机互动" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="心情问候与线上趣味内容" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="RandomInteractionCheck" Content="允许桌搭子随机发起互动"
                                                  Checked="RandomInteractionCheck_Changed" Unchecked="RandomInteractionCheck_Changed" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="InteractionModeCombo" SelectionChanged="InteractionModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="安静（60–120 分钟）" Tag="quiet" />
                                                <ComboBoxItem Content="标准（30–60 分钟）" Tag="standard" />
                                                <ComboBoxItem Content="活跃（10–30 分钟）" Tag="lively" />
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="立即互动" Margin="10,0,0,0" Click="TryInteraction_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,13" Background="{StaticResource LineBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="行为性格" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="决定移动节奏和鼠标反应" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="PersonalityCombo" Width="220" HorizontalAlignment="Left"
                                                  SelectionChanged="PersonalityCombo_SelectionChanged">
                                            <ComboBoxItem Content="活泼" Tag="lively" />
                                            <ComboBoxItem Content="害羞" Tag="shy" />
                                            <ComboBoxItem Content="黏人" Tag="clingy" />
                                            <ComboBoxItem Content="混乱" Tag="chaotic" />
                                        </ComboBox>
                                        <WrapPanel Margin="0,7,0,0">
                                            <CheckBox x:Name="MouseInteractionCheck" Content="跟随与躲避鼠标" Margin="0,6,24,6"
                                                      Checked="MouseInteractionCheck_Changed" Unchecked="MouseInteractionCheck_Changed" />
                                            <CheckBox x:Name="RandomMovementCheck" Content="自动随机走动"
                                                      Checked="RandomMovementCheck_Changed" Unchecked="RandomMovementCheck_Changed" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,13" Background="{StaticResource LineBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="随机小剧场" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="让两只桌宠偶尔同台演出" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="TheaterEnabledCheck" Content="自动随机上演"
                                                  Checked="TheaterEnabledCheck_Changed" Unchecked="TheaterEnabledCheck_Changed" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="TheaterIntervalCombo" SelectionChanged="TheaterIntervalCombo_SelectionChanged">
                                                <ComboBoxItem Content="每 1 分钟" Tag="60" />
                                                <ComboBoxItem Content="每 3 分钟" Tag="180" />
                                                <ComboBoxItem Content="每 5 分钟" Tag="300" />
                                                <ComboBoxItem Content="每 10 分钟" Tag="600" />
                                                <ComboBoxItem Content="每 30 分钟" Tag="1800" />
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="立即上演" Margin="10,0,0,0" Click="StartTheater_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,13" Background="{StaticResource LineBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="窗口行为" Style="{StaticResource SettingName}" />
                                        <TextBlock Text="控制窗口层级、启动和镜像" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel>
                                            <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,6,24,6" Click="TopmostCheck_Click" />
                                            <CheckBox x:Name="StartWithWindowsCheck" Content="开机启动" Margin="0,6,24,6" Click="StartWithWindowsCheck_Click" />
                                            <CheckBox x:Name="MirrorCheck" Content="水平镜像" Click="MirrorCheck_Click" />
                                        </WrapPanel>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="鼠标穿透" Style="{StaticResource SettingName}" />
                                                <TextBlock Text="快捷键 Ctrl + Shift + P" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button x:Name="ClickThroughButton" Grid.Column="1" Margin="18,0,0,0" Click="ClickThroughButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE91B;" Width="30"/><TextBlock Text="我的桌宠"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="我的桌宠" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="PetCountText" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="添加 GIF" Style="{StaticResource PrimaryButton}" Click="AddPet_Click" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="PetList" Grid.Row="1" MinHeight="300" Background="Transparent" BorderThickness="0" Padding="0"
                              ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Width" Value="226" />
                                <Setter Property="Height" Value="238" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Margin" Value="0,0,12,12" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="164" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#EDF3F0" CornerRadius="5" Padding="10">
                                        <controls:AnimatedGifImage FilePath="{Binding Path}" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="3,9,3,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="GIF 桌宠" Margin="0,3,0,0" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Content="使用所选" Style="{StaticResource PrimaryButton}" Click="UseSelectedPet_Click" Margin="0,0,8,0" />
                        <Button Content="使用默认" Click="UseDefaultPet_Click" Margin="0,0,8,0" />
                        <Button Content="删除所选" Style="{StaticResource DangerButton}" Click="DeletePet_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Width="30"/><TextBlock Text="资源库"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GIF 资源库" Style="{StaticResource PageTitle}" />
                                <TextBlock x:Name="LibrarySummary" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="绑定目录" Style="{StaticResource PrimaryButton}" Click="ChooseLibrary_Click" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="可用资源库" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="LibraryList" Height="208" Margin="0,0,0,14"
                                 SelectionChanged="LibraryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                   Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前目录" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LibraryPathText" IsReadOnly="True" />
                            </StackPanel>
                            <Button x:Name="DeleteLibraryButton" Grid.Column="1" Content="删除所选" Style="{StaticResource DangerButton}"
                                    Margin="12,23,0,0" VerticalAlignment="Top" Click="DeleteLibrary_Click" />
                        </Grid>

                        <Separator Style="{StaticResource SectionDivider}" />
                        <Border Style="{StaticResource SurfacePanel}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,3,0,0">
                                    <TextBlock Text="随机切换" Style="{StaticResource SettingName}" />
                                    <TextBlock Text="从当前资源库随机抽取 GIF" Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="RandomPetCheck" Content="自动随机切换桌宠" Click="RandomPetCheck_Click" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RandomIntervalCombo" SelectionChanged="RandomIntervalCombo_SelectionChanged">
                                            <ComboBoxItem Content="每 30 秒" Tag="30" />
                                            <ComboBoxItem Content="每 1 分钟" Tag="60" />
                                            <ComboBoxItem Content="每 5 分钟" Tag="300" />
                                            <ComboBoxItem Content="每 10 分钟" Tag="600" />
                                            <ComboBoxItem Content="每 30 分钟" Tag="1800" />
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="立即换一只" Margin="10,0,0,0" Click="RandomizeNow_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BD;" Width="30"/><TextBlock Text="互动内容"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                        <TextBlock Text="互动内容" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="管理线上趣味内容、互动台词和小剧场剧本" Style="{StaticResource Hint}" Margin="0,0,0,20" />

                        <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="在线趣味内容" Style="{StaticResource SettingName}" />
                                    <TextBlock x:Name="InteractionContentStatusText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="SyncInteractionContentButton" Content="在线补充" Margin="0,0,8,0"
                                            Click="SyncInteractionContent_Click" />
                                    <Button x:Name="DownloadInteractionPackButton" Content="下载离线包"
                                            Style="{StaticResource PrimaryButton}" Click="DownloadInteractionPack_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="互动词包" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="WordPackSummary" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                                <ListBox x:Name="WordPackList" Height="344" Margin="0,0,0,14"
                                         SelectionChanged="WordPackList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                           Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Content="导入词包（可多选）" Style="{StaticResource PrimaryButton}"
                                            Click="ImportWords_Click" Margin="0,0,8,8" />
                                    <Button x:Name="DeleteWordPackButton" Content="删除" Style="{StaticResource DangerButton}"
                                            Click="DeleteWordPack_Click" Margin="0,0,8,8" />
                                    <Button Content="格式说明" Click="OpenWordPackGuide_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource LineBrush}" />

                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Text="小剧场剧本" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="TheaterScriptSummary" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                                <ListBox x:Name="TheaterScriptList" Height="344" Margin="0,0,0,14"
                                         SelectionChanged="TheaterScriptList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Detail}" Margin="0,3,0,0"
                                                           Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <Button Content="导入剧本（可多选）" Style="{StaticResource PrimaryButton}"
                                            Click="ImportTheaterScript_Click" Margin="0,0,8,8" />
                                    <Button x:Name="DeleteTheaterScriptButton" Content="删除" Style="{StaticResource DangerButton}"
                                            Click="DeleteTheaterScript_Click" Margin="0,0,8,8" />
                                    <Button Content="格式说明" Click="OpenTheaterScriptGuide_Click" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" Width="30"/><TextBlock Text="提醒"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="34,28,34,32" MaxWidth="800" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="提醒" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="ReminderCountText" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="新建提醒" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="NewReminder_Click" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ReminderList" DisplayMemberPath="Display" SelectionChanged="ReminderList_SelectionChanged" />
                        <StackPanel x:Name="ReminderEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" FontSize="26" HorizontalAlignment="Center" Foreground="#93A09C" />
                            <TextBlock Text="暂无提醒" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LineBrush}" Margin="22,0" />
                    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock x:Name="ReminderFormTitle" Text="新建提醒" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16" />
                                <TextBlock Text="日期" Style="{StaticResource FieldLabel}" />
                                <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,12" />
                                <TextBlock Text="时间" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ComboBox x:Name="ReminderHourCombo" Width="104" MaxDropDownHeight="240"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ReminderTimeSelector_PreviewMouseWheel" />
                                    <TextBlock Text=":" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="10,0" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="ReminderMinuteCombo" Width="104" MaxDropDownHeight="240"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ReminderTimeSelector_PreviewMouseWheel" />
                                </StackPanel>
                                <TextBlock Text="提醒内容" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReminderMessageText" Text="休息一下吧" MaxLength="40" Margin="0,0,0,12" />
                                <TextBlock Text="情绪" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ReminderEmotionCombo" Margin="0,0,0,12">
                                    <ComboBoxItem Content="开心" Tag="happy" IsSelected="True" />
                                    <ComboBoxItem Content="加油" Tag="cheer" />
                                    <ComboBoxItem Content="害羞" Tag="shy" />
                                    <ComboBoxItem Content="惊讶" Tag="surprised" />
                                    <ComboBoxItem Content="生气" Tag="angry" />
                                    <ComboBoxItem Content="疑惑" Tag="confused" />
                                    <ComboBoxItem Content="难过" Tag="sad" />
                                    <ComboBoxItem Content="困倦" Tag="sleepy" />
                                    <ComboBoxItem Content="安静" Tag="calm" />
                                </ComboBox>
                                <TextBlock Text="指定表情 GIF（可选）" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReminderExpressionPath" IsReadOnly="True" ToolTip="提醒触发时临时展示这张 GIF" />
                                    <Button Grid.Column="1" Content="选择" Margin="8,0,0,0" Click="ChooseReminderExpression_Click" />
                                    <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Click="ClearReminderExpression_Click" />
                                </Grid>
                                <WrapPanel>
                                    <CheckBox x:Name="ReminderEnabledCheck" Content="启用提醒" IsChecked="True" Margin="0,6,24,6" />
                                    <CheckBox x:Name="ReminderDailyCheck" Content="每天重复" />
                                </WrapPanel>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="保存提醒" Style="{StaticResource PrimaryButton}" Click="SaveReminder_Click" Margin="0,0,8,0" />
                                    <Button x:Name="DeleteReminderButton" Content="删除提醒" Style="{StaticResource DangerButton}" Click="DeleteReminder_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="CompanionTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FA;" Width="30"/><TextBlock Text="搭子联机"/></StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="搭子联机" Style="{StaticResource PageTitle}" />
                                <TextBlock x:Name="CompanionStatusText" Text="正在连接搭子服务…" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Button x:Name="RefreshCompanionButton" Grid.Column="1" Content="刷新" VerticalAlignment="Center" Click="RefreshCompanion_Click" />
                        </Grid>

                        <Border Style="{StaticResource SurfacePanel}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="我的信息" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="昵称" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CompanionNameText" MaxLength="12" />
                                    <Button x:Name="SaveCompanionNameButton" Grid.Column="1" Content="保存" Margin="8,0,0,0" Click="SaveCompanionName_Click" />
                                </Grid>
                                <TextBlock Text="我的搭子码" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CompanionCodeText" IsReadOnly="True" FontFamily="Consolas" FontSize="18" CharacterCasing="Upper" />
                                    <Button x:Name="CopyCompanionCodeButton" Grid.Column="1" Content="复制" Margin="8,0,0,0" Click="CopyCompanionCode_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SurfacePanel}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="我的搭子" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="CompanionPartnerText" Text="尚未绑定" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="0,0,0,14" />
                                <Grid x:Name="PairCompanionPanel">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PairCodeText" MaxLength="8" CharacterCasing="Upper" ToolTip="输入对方的 8 位搭子码" />
                                    <Button x:Name="PairCompanionButton" Grid.Column="1" Content="绑定搭子" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="PairCompanion_Click" />
                                </Grid>
                                <WrapPanel x:Name="PairedCompanionActions" Visibility="Collapsed">
                                    <Button x:Name="SendCompanionGifButton" Content="发送当前 GIF" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="SendCompanionGif_Click" />
                                    <Button x:Name="UnpairCompanionButton" Content="解除绑定" Style="{StaticResource DangerButton}" Click="UnpairCompanion_Click" />
                                </WrapPanel>
                                <Button x:Name="CompanionActivateButton" Content="激活后使用" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="CompanionActivate_Click" />
                                <TextBlock x:Name="CompanionErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FeedbackTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE939;" Width="30"/><TextBlock Text="反馈与建议"/></StackPanel>
                </TabItem.Header>
                <Grid Margin="34,28,34,32" MaxWidth="800" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="问题反馈与建议" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="FeedbackQuotaText" Text="正在获取当前设备的反馈记录…" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button x:Name="FeedbackReloadButton" Grid.Column="1" Content="刷新" VerticalAlignment="Center" Click="FeedbackReload_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="FeedbackList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" Style="{StaticResource Hint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="FeedbackEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE939;" FontSize="26" HorizontalAlignment="Center" Foreground="#93A09C" />
                            <TextBlock Text="暂无反馈记录" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LineBrush}" Margin="22,0" />

                    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource SurfacePanel}" Margin="0,0,3,0">
                            <StackPanel>
                                <TextBlock Text="提交新反馈" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16" />
                                <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="FeedbackTypeCombo" Margin="0,0,0,12" SelectedIndex="0">
                                    <ComboBoxItem Content="问题反馈" Tag="problem" />
                                    <ComboBoxItem Content="功能建议" Tag="suggestion" />
                                </ComboBox>
                                <TextBlock Text="标题" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FeedbackTitleText" MaxLength="80" Margin="0,0,0,12" />
                                <TextBlock Text="详细说明" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FeedbackContentText" MaxLength="2000" Height="164"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top" />
                                <TextBlock x:Name="FeedbackFormHint" Text="待处理和进行中的反馈最多同时保留 3 条。"
                                           Style="{StaticResource Hint}" Margin="0,9,0,0" />
                                <TextBlock x:Name="FeedbackErrorText" Foreground="{StaticResource DangerBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed" />
                                <Button x:Name="FeedbackSubmitButton" Content="提交反馈" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" Click="FeedbackSubmit_Click" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="UpdatesTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" Width="30"/><TextBlock Text="更新"/></StackPanel>
                </TabItem.Header>
                <StackPanel Margin="34,28,34,32" MaxWidth="780" HorizontalAlignment="Stretch">
                    <TextBlock Text="软件更新" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="LicenseStatusText" Margin="0,4,0,20" Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}" />
                    <Border Style="{StaticResource SurfacePanel}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SoftBrush}" VerticalAlignment="Top">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UpdateStatusText" FontSize="14" FontWeight="SemiBold" Text="可以检查更新" Foreground="{StaticResource InkBrush}" />
                                <TextBlock x:Name="UpdateNotesText" Margin="0,8,0,0" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutoUpdateCheck" Content="自动检查更新" Click="AutoUpdateCheck_Click" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="更换激活码" Click="Reactivate_Click" />
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource PrimaryButton}" Click="CheckUpdate_Click" Margin="0,0,8,0" />
                        <Button x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="InstallUpdateButton" Content="更新并重启" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="IgnoreUpdateButton" Content="忽略该版本" Click="IgnoreUpdate_Click" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
