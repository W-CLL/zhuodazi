<Window x:Class="ZhuoDazi.AuthorContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联系作者" Width="360" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" ShowInTaskbar="False">
    <StackPanel Margin="28">
        <TextBlock Text="联系作者" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Image x:Name="ContactQrImage" Width="220" Height="220" Stretch="Uniform" />
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WechatIdText" IsReadOnly="True" BorderThickness="0" FontSize="15" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="复制微信号" Click="CopyWechat_Click" Padding="10,5" />
        </Grid>
    </StackPanel>
</Window>
