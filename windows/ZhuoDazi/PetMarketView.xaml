<UserControl x:Class="ZhuoDazi.PetMarketView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZhuoDazi.Controls"
        Background="#F7F9F8" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        Loaded="View_Loaded" Unloaded="View_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ItemsPanelTemplate x:Key="TwoColumnItemsPanel"><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202323" />
            <Setter Property="BorderBrush" Value="#D9DEDC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#167D6C" />
            <Setter Property="BorderBrush" Value="#167D6C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#52605C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="White" BorderBrush="#D9E3DF" BorderThickness="1"
                                CornerRadius="15" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#DDF1E9" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#78B9A7" />
                                <Setter Property="Foreground" Value="#126452" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202323" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="桌宠小铺" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="EnvironmentBadge" Visibility="Collapsed" Background="#E9F4FF" BorderBrush="#B8D5ED"
                            BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="10,3,0,0">
                        <TextBlock Text="本地预览" Foreground="#386987" FontSize="12" />
                    </Border>
                </WrapPanel>
                <TextBlock Text="挑一个喜欢的角色，预览满意后再领取或购买。安装不会自动替换当前桌宠。"
                           Foreground="#687470" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="OrdersButton" Content="订单记录" Click="Orders_Click" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="ActivationBanner" Grid.Row="1" Background="#FFF4D8" BorderBrush="#E6C875"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ActivationText" Text="游客和试用可以浏览预览；领取、购买、下载和启用需要正式激活。"
                           Foreground="#765A11" VerticalAlignment="Center" />
                <Button x:Name="ActivationButton" Grid.Column="1" Content="正式激活" Click="Activation_Click"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D9E3DF" BorderThickness="1" CornerRadius="8" Padding="11,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" Foreground="#7B8984" FontSize="18" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             Padding="7,9" FontSize="13" TextChanged="SearchBox_TextChanged"
                             ToolTip="按名称、介绍或标签搜索" />
                </Grid>
            </Border>
            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                <RadioButton x:Name="AllFilter" GroupName="MarketFilter" Tag="all" Content="全部"
                             Style="{StaticResource FilterChip}" IsChecked="True" Checked="Filter_Checked" />
                <RadioButton x:Name="FreeFilter" GroupName="MarketFilter" Tag="free" Content="免费"
                             Style="{StaticResource FilterChip}" Checked="Filter_Checked" />
                <RadioButton x:Name="PaidFilter" GroupName="MarketFilter" Tag="paid" Content="付费"
                             Style="{StaticResource FilterChip}" Checked="Filter_Checked" />
                <RadioButton x:Name="OwnedFilter" GroupName="MarketFilter" Tag="owned" Content="已拥有"
                             Style="{StaticResource FilterChip}" Checked="Filter_Checked" />
            </WrapPanel>
        </Grid>

        <ScrollViewer x:Name="MarketContentViewport" Grid.Row="3" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="MarketContentGrid" MinWidth="720" Width="{Binding ActualWidth, ElementName=MarketContentViewport}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CatalogColumn" Width="*" />
                <ColumnDefinition x:Name="ContentGapColumn" Width="14" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CatalogPanel" Background="White" BorderBrush="#DFE6E3" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <ListBox x:Name="ProductList" Background="Transparent" BorderThickness="0" Padding="0"
                             SelectionChanged="ProductList_SelectionChanged"
                             ItemsPanel="{StaticResource TwoColumnItemsPanel}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,9,9" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Background="#FBFDFC" BorderBrush="#E2EAE6" BorderThickness="1"
                                                    CornerRadius="10" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#F2F8F5" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#A9D0C3" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#EAF6F1" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#49A68E" />
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Height="104" Background="#EDF5F1" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="8"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Background="#167D6C" CornerRadius="8" Padding="7,3" Margin="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Visibility="{Binding IsFeatured, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="精选" Foreground="White" FontSize="11" />
                                        </Border>
                                        <Border Background="#FFFFFF" BorderBrush="#B8DACE" BorderThickness="1" CornerRadius="8"
                                                Padding="7,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="默认" Foreground="#167D6C" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="11,9,11,11">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Description}" Foreground="#6A7773" FontSize="11" Margin="0,4,0,0"
                                                   Height="33" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#E5F1EC" CornerRadius="7" Padding="6,2" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}" Foreground="#37705F" FontSize="10" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PriceLabel}" Foreground="#167D6C" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding OwnershipLabel}" Foreground="#71807B" FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AssetLabel}" Foreground="#7C8985" FontSize="10"
                                                       VerticalAlignment="Bottom" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="#FBFDFC" CornerRadius="8" Padding="26">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                            <TextBlock x:Name="EmptyStateTitle" Text="没有找到桌宠" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateText" Text="换个关键词或筛选条件试试。" Foreground="#71807B"
                                       TextAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="DetailPanel" Grid.Column="2" Background="White" BorderBrush="#DFE6E3" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="PaymentPanel" Visibility="Collapsed" Background="#F0F7F4" BorderBrush="#78B9A7"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="完成付款" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CountdownText" Grid.Column="1" FontWeight="SemiBold" Foreground="#167D6C"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="PaymentProductText" Foreground="#56645F" Margin="0,7,0,0" />
                                <TextBlock x:Name="PaymentAmountText" FontSize="18" FontWeight="SemiBold" Foreground="#167D6C"
                                           Margin="0,5,0,0" />

                                <Border x:Name="PaymentHealthPanel" Visibility="Collapsed" Background="#FFF4D8" BorderBrush="#E6C875"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                    <TextBlock x:Name="PaymentHealthText" Foreground="#765A11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>

                                <Border Background="White" BorderBrush="#C9DED6" BorderThickness="1" CornerRadius="8"
                                        Padding="12" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="转账说明请填写此短码" Foreground="#687470" FontSize="12" />
                                            <TextBlock x:Name="PaymentReferenceText" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                                       Foreground="#167D6C" Margin="0,3,0,0" />
                                            <TextBlock Text="3 个数字 + 2 个字母，请完整填写" Foreground="#7B8884" FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="复制短码" Click="CopyReference_Click" Padding="11,5"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <Border x:Name="PersonalTransferPanel" Visibility="Collapsed" Background="White" BorderBrush="#D9E5E0"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="添加收款方后转账" FontWeight="SemiBold" />
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="收款人" Foreground="#6B7874" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PaymentRecipientNameText" Grid.Column="1" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="复制" Tag="name" Click="CopyPaymentField_Click" Padding="9,4" MinHeight="30" />
                                        </Grid>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="微信号" Foreground="#6B7874" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PaymentRecipientAccountText" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="复制" Tag="account" Click="CopyPaymentField_Click" Padding="9,4" MinHeight="30" />
                                        </Grid>
                                        <TextBlock Text="1. 打开收款方聊天   2. 点击转账并填写上方准确金额&#x0a;3. 转账说明填写短码   4. 转账匹配后自动开放下载"
                                                   Foreground="#56645F" LineHeight="22" Margin="0,11,0,0" />
                                        <TextBlock x:Name="PaymentInstructionsText" Foreground="#7A8783" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="QrPaymentPanel" Visibility="Collapsed" Background="White" BorderBrush="#D9E5E0"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#F4F7F5" CornerRadius="7" Padding="6" Width="102" Height="102">
                                            <Image x:Name="PaymentQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,2,0,0">
                                            <TextBlock Text="扫码支付" FontWeight="SemiBold" />
                                            <Grid x:Name="PaymentQrRecipientPanel" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="收款人：" Foreground="#6B7874" />
                                                <TextBlock x:Name="PaymentQrRecipientNameText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="请核对金额，付款说明填写上方短码。收款核对完成后开放下载。"
                                                       Foreground="#56645F" Margin="0,8,0,0" />
                                            <TextBlock x:Name="PaymentQrInstructionsText" Foreground="#7A8783" FontSize="11" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button x:Name="CancelOrderButton" Content="取消订单" Click="CancelOrder_Click"
                                        HorizontalAlignment="Left" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid>
                                    <Border Background="#EDF3F0" CornerRadius="9" Height="132" Padding="9">
                                        <controls:AnimatedGifImage x:Name="PreviewImage" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Border x:Name="PreviewEnvironmentBadge" Visibility="Collapsed" Background="#E9F4FF"
                                            BorderBrush="#B8D5ED" BorderThickness="1" CornerRadius="8" Padding="7,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                        <TextBlock Text="本地预览" Foreground="#386987" FontSize="10" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="PreviousPreviewButton" Content="‹" ToolTip="上一张" Click="PreviousPreview_Click" Padding="9,4" MinHeight="30" />
                                    <TextBlock x:Name="PreviewCountText" Grid.Column="1" Text="0/0" Foreground="#687470"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Button x:Name="NextPreviewButton" Grid.Column="2" Content="›" ToolTip="下一张" Click="NextPreview_Click" Padding="9,4" MinHeight="30" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                <TextBlock x:Name="ProductTitleText" Text="选择一个桌宠" FontSize="19" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,7,0,0">
                                    <TextBlock x:Name="ProductPriceText" Foreground="#167D6C" FontSize="17" FontWeight="SemiBold" />
                                    <Border x:Name="ProductOwnedBadge" Visibility="Collapsed" Background="#E5F1EC" CornerRadius="8"
                                            Padding="7,3" Margin="8,0,0,0">
                                        <TextBlock Text="已拥有" Foreground="#34705F" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                                <ItemsControl x:Name="DetailTags" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#EEF5F2" CornerRadius="7" Padding="7,2" Margin="0,0,5,4">
                                                <TextBlock Text="{Binding}" Foreground="#4C7468" FontSize="10" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ProductDescriptionText" Foreground="#687470" Margin="0,13,0,0" />
                        <TextBlock x:Name="ProductMetaText" Foreground="#7A8783" Margin="0,8,0,0" FontSize="12" />

                        <WrapPanel Margin="0,17,0,0">
                            <Button x:Name="ClaimButton" Content="免费领取" Style="{StaticResource PrimaryButton}"
                                    Click="Claim_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                            <Button x:Name="BuyButton" Content="购买" Style="{StaticResource PrimaryButton}"
                                    Click="Buy_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                            <Button x:Name="InstallButton" Content="下载并安装" Click="Install_Click"
                                    Margin="0,0,8,8" Visibility="Collapsed" />
                            <Button x:Name="UseButton" Content="启用这个桌宠" Style="{StaticResource PrimaryButton}"
                                    Click="Use_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                        </WrapPanel>
                        <TextBlock x:Name="PaymentAvailabilityText" Visibility="Collapsed" Foreground="#9B5C19"
                                   FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="正在加载小铺…" Foreground="#167D6C" Margin="0,12,0,0" />
    </Grid>
</UserControl>
