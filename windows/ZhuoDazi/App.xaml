<Application x:Class="ZhuoDazi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="InkColor">#202323</Color>
        <Color x:Key="MutedColor">#6B7170</Color>
        <Color x:Key="LineColor">#D9DEDC</Color>
        <Color x:Key="SurfaceColor">#F8FAF9</Color>
        <Color x:Key="AccentColor">#167D6C</Color>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202323" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Application.Resources>
</Application>
