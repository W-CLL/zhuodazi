<UserControl x:Class="ZhuoDazi.ResourcePackView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F7F9F8" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        Loaded="View_Loaded" Unloaded="View_Unloaded">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="TwoColumnItemsPanel">
            <UniformGrid Columns="2" VerticalAlignment="Top" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="OneColumnItemsPanel">
            <UniformGrid Columns="1" VerticalAlignment="Top" />
        </ItemsPanelTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202323" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#31413C" />
            <Setter Property="BorderBrush" Value="#D2DEDA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#167D6C" />
            <Setter Property="BorderBrush" Value="#167D6C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#52605C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,7,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="White" BorderBrush="#D9E3DF"
                                BorderThickness="1" CornerRadius="15" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#DDF1E9" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#78B9A7" />
                                <Setter Property="Foreground" Value="#126452" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResourceCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE7E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBFDFC" />
                    <Setter Property="BorderBrush" Value="#A9D0C3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,22,12,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="小剧场与互动词库" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="扩充桌搭子的演出与回应；安装后仍由你决定是否启用。"
                           Foreground="#687470" Margin="0,6,12,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click"
                    VerticalAlignment="Top" ToolTip="刷新资源列表" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,16,12,6" VerticalAlignment="Center">
            <Border Width="282" Height="38" Background="White" BorderBrush="#D9E3DF"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,14,8" Padding="11,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" Foreground="#7B8984" FontSize="18" VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索名称或简介" Foreground="#98A29F"
                                   Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 Padding="8,8,0,8" FontSize="13" TextChanged="Filter_Changed"
                                 ToolTip="按名称或简介搜索资源" />
                    </Grid>
                </Grid>
            </Border>
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="AllCategory" GroupName="ResourceCategory" Tag="all" Content="全部"
                             Style="{StaticResource FilterChip}" IsChecked="True" Checked="Category_Checked" />
                <RadioButton GroupName="ResourceCategory" Tag="theater-scripts" Content="小剧场"
                             Style="{StaticResource FilterChip}" Checked="Category_Checked" />
                <RadioButton GroupName="ResourceCategory" Tag="interaction-words" Content="互动词库"
                             Style="{StaticResource FilterChip}" Checked="Category_Checked" />
            </WrapPanel>
        </WrapPanel>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ContentViewport" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                          SizeChanged="View_SizeChanged">
                <ItemsControl x:Name="PackList" HorizontalContentAlignment="Stretch"
                              ItemsPanel="{StaticResource TwoColumnItemsPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResourceCard}" MinHeight="248">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" Background="{Binding CategoryBackground}"
                                                BorderBrush="{Binding CategoryBorder}" BorderThickness="1"
                                                CornerRadius="8" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Pack.Icon}" Foreground="{Binding CategoryForeground}"
                                                       FontSize="21" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Pack.CategoryLabel}" Foreground="{Binding CategoryForeground}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Pack.Title}" FontSize="16" FontWeight="SemiBold"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Pack.Title}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#E5F2EC" BorderBrush="#B9D9CD"
                                                BorderThickness="1" CornerRadius="8" Padding="8,3"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="免费" Foreground="#167D6C" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Pack.Description}" Foreground="#5F6C68"
                                               FontSize="12" LineHeight="20" Margin="0,13,0,0" Height="42"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Pack.Description}" />

                                    <TextBlock Grid.Row="2" Text="{Binding MetaText}" Foreground="#87918E"
                                               FontSize="11" Margin="0,9,0,0" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Row="4" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding StateBackground}" BorderBrush="{Binding StateBorder}"
                                                BorderThickness="1" CornerRadius="8" Padding="8,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Grid.Column="1" Content="{Binding DownloadLabel}" Tag="{Binding Pack}"
                                                Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanDownload}"
                                                Visibility="{Binding DownloadVisibility}" Click="Download_Click"
                                                Margin="12,0,0,0" />
                                        <Button Grid.Column="1" Content="{Binding EnableLabel}" Tag="{Binding Pack}"
                                                IsEnabled="{Binding CanEnable}" Visibility="{Binding EnableVisibility}"
                                                Click="Enable_Click" Margin="12,0,0,0" MinWidth="78">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderBrush" Value="#BFCBC7" />
                                                            <Setter Property="Foreground" Value="#4F5D59" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="LoadingStatePanel" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在获取免费内容…" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="请稍候" Foreground="#7A8783" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="EmptyStatePanel" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310">
                    <TextBlock x:Name="EmptyStateTitle" Text="暂无可下载内容" FontSize="17"
                               FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyStateText" Text="后台上架后会显示在这里。" Foreground="#71807B"
                               TextAlignment="Center" Margin="0,7,0,0" />
                    <Button x:Name="ClearFiltersButton" Content="清除筛选" Click="ClearFilters_Click"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,3,12,0">
            <TextBlock x:Name="StatusText" Foreground="#167D6C" />
            <TextBlock Text="已安装内容可在“灵感口袋”管理。启用剧本后加入演出候选，自动演出仍由“陪伴日常”的小剧场开关控制；停用不会删除本地资源。"
                       Foreground="#7A8783" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
