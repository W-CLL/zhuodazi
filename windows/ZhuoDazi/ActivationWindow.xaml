<Window x:Class="ZhuoDazi.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解锁桌搭子完整功能" Width="580" Height="720"
        MinWidth="560" MinHeight="620" MaxWidth="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAF9" Icon="pack://application:,,,/assets/app-icon.png"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="KeepItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#2A5B50" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PauseItem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6A5A4A" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Width="48" Height="48" Source="pack://application:,,,/assets/app-icon.png" />
                <StackPanel Margin="14,1,0,0">
                    <TextBlock x:Name="HeadingText" Text="解锁桌搭子完整功能" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="想给对方桌面发一张 GIF，或继续小剧场和提醒时，再输入激活码。"
                               Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="TrialSummary" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#EEF6F3" BorderBrush="#C7DDD6" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="继续留下" FontSize="12" FontWeight="SemiBold" Foreground="#167D6C" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource KeepItem}" Text="· 桌宠还在角落" />
                        <TextBlock Style="{StaticResource KeepItem}" Text="· 走动、拖动、换一只" />
                        <TextBlock Style="{StaticResource KeepItem}" Text="· 内置图鉴和 3 个自定义 GIF" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FBF6F1" BorderBrush="#E6D6C6" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="想接着玩再回来" FontSize="12" FontWeight="SemiBold" Foreground="#9A6A3A" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource PauseItem}" Text="· 给搭子发 GIF" />
                        <TextBlock Style="{StaticResource PauseItem}" Text="· 小剧场、提醒" />
                        <TextBlock Style="{StaticResource PauseItem}" Text="· 词包和外部图鉴" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="已有 6 位激活码" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBox x:Name="CodeTextBox" Height="54" Margin="0,8,0,0" MaxLength="6"
                         Padding="14,4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" CharacterCasing="Upper"
                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White"
                         TextChanged="CodeTextBox_TextChanged" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0" MinHeight="28">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B3262D" FontSize="12" TextWrapping="Wrap" />
                <ProgressBar x:Name="ActivationProgress" Height="4" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="4" Margin="0,8,0,0" Background="White" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="168" Height="168" Stretch="Uniform"
                           Source="pack://application:,,,/assets/contact-author-wechat.png" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="还没有激活码" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="加作者微信，备注「桌搭子」，按提示领取激活码。一般当天回。" />
                        <TextBlock Margin="0,10,0,0" Text="微信号" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="wcl_lcw627" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="CopyWeChatButton" Content="复制微信号" Click="CopyWeChat_Click" Margin="0,0,8,0" Padding="12,6" MinHeight="34" />
                            <Button x:Name="XianyuButton" Content="去闲鱼看看" Click="Xianyu_Click" Padding="12,6" MinHeight="34" Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="WebsiteButton" Content="去官网看看" Click="Website_Click" Margin="0,0,8,0" />
                <Button x:Name="ContinueButton" Content="先留下桌宠" Click="Continue_Click" Margin="0,0,8,0" />
                <Button x:Name="ActivateButton" Content="立即激活" Width="108" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="ActivateButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
