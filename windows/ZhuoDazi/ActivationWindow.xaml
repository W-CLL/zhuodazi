<Window x:Class="ZhuoDazi.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="激活桌搭子" Width="520" Height="430"
        MinWidth="520" MinHeight="430" MaxWidth="520" MaxHeight="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAF9" Icon="pack://application:,,,/assets/app-icon.png"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="44,34,44,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Width="52" Height="52" Source="pack://application:,,,/assets/app-icon.png" />
            <StackPanel Margin="14,1,0,0">
                <TextBlock Text="激活桌搭子" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="首次使用需要设备授权" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,30,0,0">
            <TextBlock Text="6 位激活码" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBox x:Name="CodeTextBox" Height="58" Margin="0,9,0,0" MaxLength="6"
                     Padding="14,4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     FontFamily="Consolas" FontSize="27" FontWeight="SemiBold" CharacterCasing="Upper"
                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White"
                     TextChanged="CodeTextBox_TextChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0" MinHeight="36">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B3262D" FontSize="12" TextWrapping="Wrap" />
            <ProgressBar x:Name="ActivationProgress" Height="4" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="退出" Click="Exit_Click" Margin="0,0,8,0" />
            <Button x:Name="ActivateButton" Content="激活" Width="112" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="ActivateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
