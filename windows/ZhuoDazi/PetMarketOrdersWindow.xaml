<Window x:Class="ZhuoDazi.PetMarketOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌搭子 · 订单记录" Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F9F8"
        UseLayoutRounding="True" FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/ZhuoDazi;component/assets/app-icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202323" />
            <Setter Property="BorderBrush" Value="#D9DEDC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#167D6C" />
            <Setter Property="BorderBrush" Value="#167D6C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202323" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="订单记录" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="待付款、已付款和已结束的订单都会保留在这里。" Foreground="#687470" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#DFE6E3" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <ListBox x:Name="OrderList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OrderList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="#FBFDFC" BorderBrush="#E2EAE6"
                                                    BorderThickness="1" CornerRadius="7" Padding="11,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#F2F8F5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#EAF6F1" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#49A68E" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProductTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="#167D6C"
                                                   FontSize="11" Margin="8,1,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding AmountLabel}" Foreground="#3F4C48" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding CreatedLabel}" Foreground="#7A8783" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock Text="还没有订单记录" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="购买付费桌宠后，订单会显示在这里。" Foreground="#71807B"
                                   TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DFE6E3" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="SelectOrderText" Text="选择一条订单查看详情" Foreground="#71807B"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DetailScrollViewer" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ProductTitleText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OrderStatusText" Foreground="#167D6C" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="AmountText" Grid.Column="1" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#167D6C" VerticalAlignment="Top" />
                            </Grid>

                            <Border x:Name="PaidSuccessPanel" Visibility="Collapsed" Background="#EAF6F1"
                                    BorderBrush="#92C9B8" BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,13,0,0">
                                <StackPanel>
                                    <TextBlock Text="付款验证成功" Foreground="#126452" FontWeight="SemiBold" />
                                    <TextBlock x:Name="InstallStatusText" Foreground="#47665C" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="PaymentWarningPanel" Visibility="Collapsed" Background="#FFF4D8"
                                    BorderBrush="#E6C875" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,11,0,0">
                                <TextBlock x:Name="PaymentWarningText" Foreground="#765A11" FontWeight="SemiBold" />
                            </Border>

                            <Border x:Name="ReferencePanel" Background="#F3F8F6" BorderBrush="#C9DED6"
                                    BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="付款短码" Foreground="#687470" FontSize="11" />
                                        <TextBlock x:Name="ReferenceText" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                                   Foreground="#167D6C" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="复制" Click="CopyReference_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="收款人" Foreground="#6B7874" />
                                <TextBlock x:Name="RecipientNameText" Grid.Column="1" FontWeight="SemiBold" Margin="12,0,0,0" />
                            </Grid>
                            <Grid x:Name="RecipientAccountRow" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="微信号" Foreground="#6B7874" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecipientAccountText" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="复制" Click="CopyRecipient_Click" Padding="9,4" MinHeight="30" />
                            </Grid>

                            <Border x:Name="QrPanel" Visibility="Collapsed" Background="#F4F7F5" CornerRadius="7"
                                    Padding="8" Width="156" Height="156" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="PaymentInstructionsText" Foreground="#687470" Margin="0,10,0,0" />

                            <Separator Margin="0,15,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="订单号" Foreground="#7A8783" />
                                <TextBlock x:Name="OrderIdText" Grid.Column="1" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="商品版本" Foreground="#7A8783" />
                                <TextBlock x:Name="VersionText" Grid.Column="1" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="创建时间" Foreground="#7A8783" />
                                <TextBlock x:Name="CreatedAtText" Grid.Column="1" />
                            </Grid>
                            <Grid x:Name="ExpiresAtRow" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="付款截止" Foreground="#7A8783" />
                                <TextBlock x:Name="ExpiresAtText" Grid.Column="1" />
                            </Grid>
                            <Grid x:Name="PaidAtRow" Visibility="Collapsed" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="付款确认" Foreground="#7A8783" />
                                <TextBlock x:Name="PaidAtText" Grid.Column="1" />
                            </Grid>
                            <Grid x:Name="CanceledAtRow" Visibility="Collapsed" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="取消时间" Foreground="#7A8783" />
                                <TextBlock x:Name="CanceledAtText" Grid.Column="1" />
                            </Grid>

                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="OpenProductButton" Content="查看商品" Style="{StaticResource PrimaryButton}"
                                        Click="OpenProduct_Click" Margin="0,0,8,8" />
                                <Button x:Name="RetryInstallButton" Content="重试下载安装" Click="RetryInstall_Click"
                                        Margin="0,0,8,8" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="ConnectionWarningText" Grid.Row="2" Visibility="Collapsed" Foreground="#9B5C19"
                   FontWeight="SemiBold" Margin="0,11,0,0" />
    </Grid>
</Window>
