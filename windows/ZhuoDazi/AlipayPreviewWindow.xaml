<Window x:Class="ZhuoDazi.AlipayPreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="桌搭子 · 支付宝本地预览" Width="1020" Height="790" MinWidth="780" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="#F5F8F7" FontFamily="Microsoft YaHei UI"
 UseLayoutRounding="True" Loaded="Window_Loaded" Closed="Window_Closed" Activated="Window_Activated">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,8"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#20362F"/>
   <Setter Property="BorderBrush" Value="#CDDDD5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#167D6C"/><Setter Property="BorderBrush" Value="#167D6C"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#263E34"/></Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="桌搭子 · 电脑网站支付预览" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="从桌面发起订单，在网页确认商品，再跳转支付宝电脑网站付款。" Foreground="#65796E" Margin="0,7,0,0"/></StackPanel>
   <Button x:Name="RefreshButton" Content="刷新状态" Click="Refresh_Click" Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0"/>
  </Grid>
  <Border Grid.Row="1" Background="#EDF4F0" CornerRadius="9" Padding="13,10" Margin="0,17,0,17">
   <StackPanel><TextBlock Text="本地独立预览 · API 127.0.0.1:18788" FontWeight="SemiBold" Foreground="#216C57"/>
    <TextBlock x:Name="ProviderText" Text="正在读取本地支付服务…" Foreground="#65796E" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="ModeTabs" SelectionChanged="ModeTabs_SelectionChanged" Background="Transparent" BorderThickness="0">
    <TabItem Header="未激活 · 激活桌搭子">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="14,20,14,14">
       <TextBlock Text="让桌搭子一直陪着你" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock x:Name="ActivationDescription" Text="读取激活商品介绍中…" Foreground="#65796E" Margin="0,12,0,14"/>
       <TextBlock x:Name="ActivationPrice" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#167D6C"/>
       <TextBlock Text="此页使用独立的未激活本地身份，付款交付后可在右侧查看激活码。" Foreground="#65796E" Margin="0,12,0,18"/>
       <Button x:Name="ActivateButton" Content="激活桌搭子 →" Style="{StaticResource Primary}" Click="Activate_Click" IsEnabled="False"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="已激活 · 桌宠小铺">
     <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="本地已激活身份 · 选中桌宠后，去网页查看商品和支付。" Foreground="#65796E" Margin="8,0,8,12"/>
      <ListBox x:Name="ProductList" Grid.Row="1" BorderThickness="0" Background="Transparent"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProductList_SelectionChanged">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Border Background="White" BorderBrush="#D9E4DE" BorderThickness="1" CornerRadius="9" Padding="15">
         <StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Description}" Foreground="#65796E" Margin="0,8,0,8"/>
          <TextBlock Text="{Binding PriceLabel}" FontSize="18" FontWeight="SemiBold" Foreground="#167D6C"/>
         </StackPanel></Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </TabItem>
   </TabControl>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9E4DE" BorderThickness="1" CornerRadius="10" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="当前订单" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="OrderTitle" Text="选好商品后，点击下方按钮开始。" Margin="0,16,0,10" FontSize="17"/>
      <TextBlock x:Name="OrderPrice" FontSize="26" FontWeight="SemiBold" Foreground="#167D6C"/>
      <TextBlock x:Name="OrderStatus" Text="还没有创建订单" Margin="0,12,0,8" FontWeight="SemiBold"/>
      <TextBlock x:Name="OrderDetail" Foreground="#65796E"/>
      <Border x:Name="CodePanel" Visibility="Collapsed" Background="#EDF7F0" CornerRadius="8" Padding="14" Margin="0,16,0,0">
       <StackPanel><TextBlock Text="已交付激活码" Foreground="#216C57"/>
        <TextBox x:Name="ActivationCode" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"/>
        <Button Content="复制激活码" Click="CopyCode_Click"/>
       </StackPanel>
      </Border>
      <Button x:Name="BuyButton" Content="选择桌宠后前往网页 →" Style="{StaticResource Primary}" Click="Buy_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,20,0,0"/>
      <Button x:Name="OpenCheckoutButton" Content="重新打开网页收银台 ↗" Click="OpenCheckout_Click" IsEnabled="False" Margin="0,12,0,0"/>
      <TextBlock Text="在网页点击支付宝付款后，浏览器会前往支付宝官方收银台。付款后回到此窗口查看服务端确认的结果。" Foreground="#7C8C82" FontSize="12" Margin="0,16,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="正在连接本地服务…" Foreground="#167D6C" Margin="0,16,0,0"/>
 </Grid>
</Window>
