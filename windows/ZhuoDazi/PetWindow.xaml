<Window x:Class="ZhuoDazi.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌搭子"
        Width="320" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="InteractionChoiceButton" TargetType="Button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#26302D" />
            <Setter Property="BorderBrush" Value="#C9D2CF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="BubbleRow" Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="InteractionCard" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MaxWidth="350" Margin="10,0,10,4" Padding="14,13" CornerRadius="6"
                Background="#F9FBFA" BorderBrush="#AFC1BB" BorderThickness="1"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.2" />
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InteractionTitle" FontSize="11" FontWeight="SemiBold"
                               Foreground="#167D6C" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Width="26" Height="26" MinWidth="26" MinHeight="26"
                            Margin="8,-3,-4,0" Padding="0" FontSize="17" Background="Transparent"
                            BorderBrush="Transparent" Cursor="Hand" ToolTip="稍后再说"
                            Click="DismissInteraction_Click" />
                </Grid>
                <ScrollViewer x:Name="InteractionMessageScroll" Margin="0,0,0,10"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <TextBlock x:Name="InteractionMessage"
                               Foreground="#202323" FontSize="13" LineHeight="20"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <WrapPanel x:Name="InteractionChoicePanel" />
            </StackPanel>
        </Border>

        <Border x:Name="SpeechBubble" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MaxWidth="280" Margin="12,0,12,4" Padding="13,9" CornerRadius="6"
                Background="#F9FBFA" BorderBrush="#C9D2CF" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.16" />
            </Border.Effect>
            <TextBlock x:Name="SpeechText" Foreground="#202323" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1" x:Name="PetStage" Background="Transparent" Cursor="Hand"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MirrorTransform" ScaleX="1" />
                    <RotateTransform x:Name="SecretRotateTransform" Angle="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="PetImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid x:Name="DefaultPet" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="150" Height="138" Fill="#F5F7F6" Stroke="#293331" StrokeThickness="3" />
                <Ellipse Width="16" Height="22" Fill="#293331" Margin="-45,-15,0,0" />
                <Ellipse Width="16" Height="22" Fill="#293331" Margin="45,-15,0,0" />
                <Path Data="M 72,102 Q 90,116 108,102" Stroke="#293331" StrokeThickness="3" Fill="Transparent" />
                <Ellipse Width="22" Height="10" Fill="#E8A5A0" Opacity="0.65" Margin="-88,46,0,0" />
                <Ellipse Width="22" Height="10" Fill="#E8A5A0" Opacity="0.65" Margin="88,46,0,0" />
            </Grid>
        </Grid>

    </Grid>
</Window>
