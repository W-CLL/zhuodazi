<Window x:Class="ZhuoDazi.UninstallFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载桌搭子" Width="600" Height="650" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#F8FAF9" Icon="pack://application:,,,/ZhuoDazi;component/assets/app-icon.png"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="36,28,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Width="48" Height="48" Source="pack://application:,,,/ZhuoDazi;component/assets/app-icon.png" />
            <StackPanel Margin="14,1,0,0">
                <TextBlock Text="卸载桌搭子" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="原因可选；也可以直接跳过。取消会保留桌搭子，不会开始卸载。" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="18,16" Background="White"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="愿意告诉我们为什么吗？（可选）" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,14" />
                <UniformGrid Columns="2">
                    <RadioButton GroupName="Reason" Content="不选择原因" Tag="" IsChecked="True" Checked="Reason_Checked" />
                    <RadioButton GroupName="Reason" Content="不常用" Tag="not_often_used" Checked="Reason_Checked" />
                    <RadioButton GroupName="Reason" Content="占用资源" Tag="resource_usage" Checked="Reason_Checked" />
                    <RadioButton GroupName="Reason" Content="体验问题" Tag="experience_issue" Checked="Reason_Checked" />
                    <RadioButton GroupName="Reason" Content="暂时不用" Tag="temporary_pause" Checked="Reason_Checked" />
                    <RadioButton GroupName="Reason" Content="其他" Tag="other" Checked="Reason_Checked" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="补充说明（仅选择“其他”时可填）" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBox x:Name="CommentTextBox" Height="94" Margin="0,8,0,0" Padding="10,8"
                     MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="False"
                     VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource LineBrush}"
                     BorderThickness="1" Background="White" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,18,0,0" Padding="14,12" Background="#EEF6F3"
                BorderBrush="#C7DDD6" BorderThickness="1" CornerRadius="6">
            <TextBlock FontSize="12" Foreground="#2A5B50" TextWrapping="Wrap"
                       Text="卸载不会解除授权、释放设备名额，也不会删除已购买内容。网络不可用时，卸载仍会继续。" />
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0" MinHeight="34">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <ProgressBar x:Name="SubmitProgress" Height="4" VerticalAlignment="Bottom"
                         IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Width="82" Margin="0,0,8,0"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button x:Name="SkipButton" Grid.Column="2" Content="跳过反馈并卸载" Margin="0,0,8,0"
                    Click="SkipButton_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="3" Content="确认卸载" Width="104"
                    IsDefault="True" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click" />
        </Grid>
    </Grid>
</Window>
